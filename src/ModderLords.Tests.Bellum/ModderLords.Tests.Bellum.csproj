<Project Sdk="Microsoft.NET.Sdk">

  <!-- The bellum test module's own steps (docs/WRITING-TEST-MODULES.md, section 7). The test agent loads it by hand,
       into a game that already has ModderLords.Compat, Bellum Civile and its Coop compat module loaded. It reads Bellum
       and the compat module by reflection only, so it builds everywhere (CI too); the launcher copies it into its
       compat folder. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ModderLords.Tests.Bellum</AssemblyName>
    <RootNamespace>ModderLords.Tests.Bellum</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The app copies this DLL from bin\$(Configuration)\; a release publish (-r win-x64) must not move it. -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Core" Version="1.4.8.119303" ExcludeAssets="runtime" />
    <ProjectReference Include="..\ModderLords.CompatSync\ModderLords.CompatSync.csproj" Private="false" />
  </ItemGroup>

</Project>
