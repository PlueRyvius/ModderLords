<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ModularCoop.CompatSync</AssemblyName>
    <RootNamespace>ModularCoop.CompatSync</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Coop assemblies are compile-time references only, taken from the local Steam workshop subscription; nothing of
         Coop's is copied into the build output or the release. Override CoopRefDir if your Steam library is elsewhere. -->
    <CoopRefDir Condition="'$(CoopRefDir)' == ''">D:\Program Files (x86)\Steam\steamapps\workshop\content\261550\3770450698\bin\Win64_Shipping_Client</CoopRefDir>
  </PropertyGroup>

  <!-- One DLL, two output folders: the client build and the server build are the same code. -->
  <PropertyGroup>
    <OutputPath>_Module\bin\Win64_Shipping_Client\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Core" Version="1.4.8.119303" ExcludeAssets="runtime" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime" />
    <Reference Include="Common" HintPath="$(CoopRefDir)\Common.dll" Private="false" />
    <Reference Include="GameInterface" HintPath="$(CoopRefDir)\GameInterface.dll" Private="false" />
    <Reference Include="LiteNetLib" HintPath="$(CoopRefDir)\LiteNetLib.dll" Private="false" />
    <Reference Include="protobuf-net" HintPath="$(CoopRefDir)\protobuf-net.dll" Private="false" />
    <Reference Include="protobuf-net.Core" HintPath="$(CoopRefDir)\protobuf-net.Core.dll" Private="false" />
    <Reference Include="Autofac" HintPath="$(CoopRefDir)\Autofac.dll" Private="false" />
  </ItemGroup>

  <Target Name="CopyServerBin" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll;$(OutDir)$(AssemblyName).pdb" DestinationFolder="_Module\bin\Win64_Shipping_Server\" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
