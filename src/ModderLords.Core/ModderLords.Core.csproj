<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bannerlord.ModuleManager" Version="6.0.249" />
    <!-- UpdateInstaller's failure seam (BeforeCopy) is for tests only. -->
    <InternalsVisibleTo Include="ModderLords.Core.Tests" />
    <InternalsVisibleTo Include="ModderLords.App.Tests" />
    <ProjectReference Include="..\ModderLords.Analysis\ModderLords.Analysis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Curated compatibility database; ships next to the exe of every consumer (app, CLI, tests). -->
    <Content Include="compat-db.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
