{
  // Troops earn Retinues XP (to spend on skills) by fighting. A field battle against map bandits, with retinues in the party; their XP pool must grow. In Coop the battle runs on the player's game. Coop only for now: battle.fight is Coop's map attack.
  "api": 2,
  "name": "xp",
  "mode": "coop",
  "description": "A party with retinues wins a field battle against bandits, and the retinue's XP pool grows on both sides.",
  "requires": [{"id": "Retinues"}],
  "steps": [
    {"id": "Retinues.health", "side": "server"},
    {"id": "Retinues.health", "side": "client:1"},
    {"id": "game.whoAmI", "side": "client:1", "as": "me"},
    {"id": "hero.addGold", "side": "server", "args": {"heroName": "$me.heroName", "amount": 20000}},
    {"id": "retinues.ready", "side": "client:1"},
    {"id": "retinues.giveFief", "side": "server", "args": {"heroName": "$me.heroName", "town": "town_EN1"}},
    {"id": "retinues.ensureTroops", "side": "client:1", "as": "troops", "args": {"regulars": "true"}},
    {"id": "retinues.addTroops", "side": "server", "args": {"heroName": "$me.heroName", "troop": "$troops.retinue", "count": 20}},
    {"id": "retinues.partyCount", "side": "client:1", "args": {"heroName": "$me.heroName", "troop": "$troops.retinue", "atLeast": 20}},
    {"id": "retinues.xpPool", "side": "server", "as": "xpBefore", "args": {"troop": "$troops.retinue"}},
    {"id": "battle.placeEnemy", "side": "server", "as": "enemy", "args": {"heroName": "$me.heroName"}},
    {"id": "battle.fight", "side": "client:1", "as": "fight", "timeoutSeconds": 900, "args": {"enemy": "$enemy.value", "battleSeconds": 480, "men": 21}},
    {"id": "game.pause", "side": "server"},
    {"id": "retinues.xpPool", "side": "server", "as": "xpAfter", "args": {"troop": "$troops.retinue", "above": "$xpBefore.value"}},
    {"compare": "retinues.xpPool", "sides": ["server", "client:1"], "args": {"troop": "$troops.retinue"}, "as": "xpBoth"},
    {"id": "retinues.noErrors", "side": "server", "continueOnFail": true},
    {"id": "retinues.noErrors", "side": "client:1", "continueOnFail": true},
    {"id": "game.noErrors", "side": "server", "continueOnFail": true},
    {"id": "game.noErrors", "side": "client:1", "continueOnFail": true}
  ]
}
