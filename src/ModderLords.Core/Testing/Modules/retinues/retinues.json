{
  // Retinues: troops of the party converted into a retinue for gold and influence (up to the ratio cap), a retinue ranked up, and retinues that join by themselves as the clan's renown grows, up to the join limit.
  "api": 2,
  "name": "retinues",
  "mode": "both",
  "description": "Troops convert into retinues (capped by the party size), a retinue ranks up, and with renown and a raised join limit a retinue joins within two days; both sides agree.",
  "requires": [{"id": "Retinues"}],
  "steps": [
    {"id": "Retinues.health", "side": "game"},
    {"id": "Retinues.health", "side": "player", "mode": "coop"},
    {"id": "game.whoAmI", "side": "player", "as": "me"},
    {"id": "hero.addGold", "side": "game", "args": {"heroName": "$me.heroName", "amount": 100000}},
    {"id": "retinues.ready", "side": "player"},
    {"id": "retinues.giveFief", "side": "game", "args": {"heroName": "$me.heroName", "town": "town_EN1"}},
    {"id": "retinues.ensureTroops", "side": "player", "as": "troops", "args": {"regulars": "true"}},
    {"id": "retinues.addInfluence", "side": "game", "args": {"heroName": "$me.heroName", "amount": 500}},
    {"id": "retinues.retinueSource", "side": "player", "as": "source", "args": {"troop": "$troops.retinue"}},
    {"id": "retinues.addTroops", "side": "game", "args": {"heroName": "$me.heroName", "troop": "$source.value", "count": 10}},
    {"id": "retinues.partyCount", "side": "player", "args": {"heroName": "$me.heroName", "troop": "$source.value", "atLeast": 10}},
    {"id": "retinues.convert", "side": "player", "as": "converted", "args": {"troop": "$troops.retinue", "from": "$source.value", "count": 5}},
    {"id": "retinues.partyCount", "side": "player", "as": "retinues", "args": {"heroName": "$me.heroName", "troop": "$troops.retinue"}},
    {"compare": "retinues.partyCount", "sides": ["game", "player"], "args": {"heroName": "$me.heroName", "troop": "$troops.retinue"}, "as": "retinuesSides", "mode": "coop"},
    {"id": "retinues.giveXp", "side": "game", "args": {"troop": "$troops.retinue", "amount": 50000}},
    {"id": "retinues.rankUp", "side": "player", "args": {"troop": "$troops.retinue"}},
    {"id": "retinues.troop", "side": "player", "as": "rankedUp", "args": {"troop": "$troops.retinue"}},
    {"compare": "retinues.troop", "sides": ["game", "player"], "args": {"troop": "$troops.retinue"}, "as": "rankedUpSides", "mode": "coop"},
    {"id": "retinues.raiseJoinCap", "side": "player", "args": {"troop": "$troops.eliteRetinue", "times": 2}},
    {"id": "retinues.passDays", "side": "game", "timeoutSeconds": 400, "args": {"days": 1}},
    {"id": "retinues.addRenown", "side": "game", "args": {"heroName": "$me.heroName", "amount": 2000}},
    {"id": "retinues.passDays", "side": "game", "timeoutSeconds": 400, "args": {"days": 1}},
    {"id": "retinues.partyCount", "side": "player", "as": "joined", "args": {"heroName": "$me.heroName", "troop": "$troops.eliteRetinue", "atLeast": 1}},
    {"id": "retinues.partyCount", "side": "player", "as": "joinedBoth", "args": {"heroName": "$me.heroName", "troop": "$troops.eliteRetinue"}},
    {"compare": "retinues.partyCount", "sides": ["game", "player"], "args": {"heroName": "$me.heroName", "troop": "$troops.eliteRetinue"}, "as": "joinedBothSides", "mode": "coop"},
    {"id": "retinues.noErrors", "side": "game", "continueOnFail": true},
    {"id": "retinues.noErrors", "side": "player", "mode": "coop", "continueOnFail": true},
    {"id": "game.noErrors", "side": "game", "continueOnFail": true},
    {"id": "game.noErrors", "side": "player", "mode": "coop", "continueOnFail": true}
  ]
}
