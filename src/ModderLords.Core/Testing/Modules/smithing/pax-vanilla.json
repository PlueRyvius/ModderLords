{
  // MS2's Pax Vanilla setting (MCM > Crafted items, pax_vanilla): newly crafted armor follows vanilla tiers. The same
  // 25 recipes are crafted with the setting off, then on: 18 armor pieces across every armor slot (the best stack,
  // lighter stacks, other coverage bands, thinner and thicker pieces, horse armor) and a bow, crossbow, sling, shield,
  // arrows, bolts and sling stones. Each craft is checked against MS2's calculator under the setting it ran with. With
  // it on, smithing.pax checks the best stack in each slot against vanilla's best piece (the table in MS2 PR #95),
  // thickness (weight 1:1, armor half as fast), and that horse armor, weapons, the shield and ammo come out the same
  // either way. Then the setting goes off, and after a save and reload every piece keeps the stats it was made with.
  "api": 2,
  "name": "pax-vanilla",
  "mode": "singleplayer",
  "continuity": true,
  "description": "Pax Vanilla off and on: 18 armor pieces in every armor slot, plus weapons, a shield and ammo, crafted both ways; with it on, the best stack in each slot matches vanilla's best piece, thickness scales as designed, everything else is unchanged, and every piece keeps its stats through a save and reload.",
  "errorPatterns": [ "\\[MSmith\\].*(?<!\\b(?:0|no|zero)\\s)\\b(failed|error)" ],
  "steps": [
    { "id": "smithing.prepare", "side": "game", "args": { "skill": 330 } },
    { "id": "smithing.setSetting", "side": "game", "as": "off", "args": { "name": "pax_vanilla", "value": "false" } },
    { "id": "smithing.craft", "side": "game", "as": "off_headBest", "continueOnFail": true, "args": { "slot": "head", "inner": "gambeson_quilted", "middle": "riveted_mail", "outer": "plate_harness" } },
    { "id": "smithing.craft", "side": "game", "as": "off_headLight", "continueOnFail": true, "args": { "slot": "head", "inner": "padding_light", "outer": "leather_outer" } },
    { "id": "smithing.craft", "side": "game", "as": "off_headThin", "continueOnFail": true, "args": { "slot": "head", "inner": "gambeson_quilted", "middle": "riveted_mail", "outer": "plate_harness", "size": 50 } },
    { "id": "smithing.craft", "side": "game", "as": "off_bodyBest", "continueOnFail": true, "args": { "slot": "body", "inner": "gambeson_quilted", "middle": "riveted_mail", "outer": "plate_harness" } },
    { "id": "smithing.craft", "side": "game", "as": "off_bodyFull", "continueOnFail": true, "args": { "slot": "body", "inner": "gambeson_quilted", "middle": "riveted_mail", "outer": "plate_harness", "coverage": "extended", "checkTier": "false" } },
    { "id": "smithing.craft", "side": "game", "as": "off_bodyTorso", "continueOnFail": true, "args": { "slot": "body", "inner": "gambeson_quilted", "middle": "riveted_mail", "outer": "plate_harness", "coverage": "minimal", "checkTier": "false" } },
    { "id": "smithing.craft", "side": "game", "as": "off_bodyMail", "continueOnFail": true, "args": { "slot": "body", "middle": "chainmail_middle" } },
    { "id": "smithing.craft", "side": "game", "as": "off_bodyThick", "continueOnFail": true, "args": { "slot": "body", "inner": "linen_lining", "outer": "leather_outer", "size": 150 } },
    { "id": "smithing.craft", "side": "game", "as": "off_shouldersBest", "continueOnFail": true, "args": { "slot": "shoulders", "inner": "gambeson_quilted", "middle": "riveted_mail", "outer": "plate_harness", "checkTier": "false" } },
    { "id": "smithing.craft", "side": "game", "as": "off_shouldersScale", "continueOnFail": true, "args": { "slot": "shoulders", "middle": "chainmail_middle", "outer": "scale_outer", "checkTier": "false" } },
    { "id": "smithing.craft", "side": "game", "as": "off_shouldersThick", "continueOnFail": true, "args": { "slot": "shoulders", "middle": "studded_middle", "outer": "coat_of_plates", "size": 150, "checkTier": "false" } },
    { "id": "smithing.craft", "side": "game", "as": "off_handsBest", "continueOnFail": true, "args": { "slot": "hands", "inner": "gambeson_quilted", "middle": "riveted_mail", "outer": "plate_harness" } },
    { "id": "smithing.craft", "side": "game", "as": "off_handsPlate", "continueOnFail": true, "args": { "slot": "hands", "inner": "padding_heavy", "outer": "plate_harness" } },
    { "id": "smithing.craft", "side": "game", "as": "off_handsThin", "continueOnFail": true, "args": { "slot": "hands", "inner": "gambeson_quilted", "outer": "leather_outer", "size": 50 } },
    { "id": "smithing.craft", "side": "game", "as": "off_legsBest", "continueOnFail": true, "args": { "slot": "legs", "inner": "gambeson_quilted", "middle": "riveted_mail", "outer": "plate_harness" } },
    { "id": "smithing.craft", "side": "game", "as": "off_legsLeather", "continueOnFail": true, "args": { "slot": "legs", "inner": "gambeson_quilted", "middle": "leather_middle", "outer": "leather_outer" } },
    { "id": "smithing.craft", "side": "game", "as": "off_legsThin", "continueOnFail": true, "args": { "slot": "legs", "middle": "brigandine_middle", "outer": "lamellar_outer", "size": 75 } },
    { "id": "smithing.craft", "side": "game", "as": "off_horse", "continueOnFail": true, "args": { "slot": "horse_armor", "inner": "gambeson_quilted", "middle": "riveted_mail", "outer": "plate_harness" } },
    { "id": "smithing.craft", "side": "game", "as": "off_bow", "continueOnFail": true, "args": { "family": "bow", "slot": "bow", "inner": "bow_limbs_yew", "middle": "bow_riser_maple", "outer": "bow_string_hemp", "checkTier": "false" } },
    { "id": "smithing.craft", "side": "game", "as": "off_crossbow", "continueOnFail": true, "args": { "family": "crossbow", "slot": "crossbow", "inner": "crossbow_prod_steel", "middle": "crossbow_stock_oak", "outer": "crossbow_trigger_iron", "checkTier": "false" } },
    { "id": "smithing.craft", "side": "game", "as": "off_sling", "continueOnFail": true, "args": { "family": "sling", "slot": "sling", "inner": "sling_pouch_leather", "middle": "sling_cord_flax", "outer": "sling_grip_leather", "checkTier": "false" } },
    { "id": "smithing.craft", "side": "game", "as": "off_shield", "continueOnFail": true, "args": { "family": "shield", "slot": "shield", "inner": "shield_frame_oak", "middle": "shield_rim_iron", "outer": "shield_facing_hide", "extra": "shield_boss_iron", "checkTier": "false" } },
    { "id": "smithing.craft", "side": "game", "as": "off_arrows", "continueOnFail": true, "args": { "family": "ammo", "slot": "arrow", "inner": "arrow_shaft_hardwood", "middle": "arrow_head_bodkin", "outer": "arrow_fletching_cloth", "extra": "arrow_nock_horn", "batch": 20, "checkTier": "false" } },
    { "id": "smithing.craft", "side": "game", "as": "off_bolts", "continueOnFail": true, "args": { "family": "ammo", "slot": "bolt", "inner": "bolt_shaft_hardwood", "middle": "bolt_head_bodkin", "outer": "bolt_fletching_leather", "extra": "bolt_nock_horn", "batch": 20, "checkTier": "false" } },
    { "id": "smithing.craft", "side": "game", "as": "off_slingStones", "continueOnFail": true, "args": { "family": "ammo", "slot": "sling_stone", "inner": "sling_bullet_cast", "middle": "sling_shaping_almond", "batch": 20, "checkTier": "false" } },
    { "id": "smithing.setSetting", "side": "game", "as": "on", "args": { "name": "pax_vanilla", "value": "true" } },
    { "id": "smithing.craft", "side": "game", "as": "headBest", "continueOnFail": true, "args": { "slot": "head", "inner": "gambeson_quilted", "middle": "riveted_mail", "outer": "plate_harness" } },
    { "id": "smithing.pax", "side": "game", "as": "headBestPax", "continueOnFail": true, "args": { "item": "$headBest.value", "expect": "vanilla", "armor": "55/0/0/0", "maxKg": "3.0" } },
    { "id": "smithing.craft", "side": "game", "as": "headLight", "continueOnFail": true, "args": { "slot": "head", "inner": "padding_light", "outer": "leather_outer" } },
    { "id": "smithing.pax", "side": "game", "as": "headLightPax", "continueOnFail": true, "args": { "item": "$headLight.value", "expect": "vanilla" } },
    { "id": "smithing.craft", "side": "game", "as": "headThin", "continueOnFail": true, "args": { "slot": "head", "inner": "gambeson_quilted", "middle": "riveted_mail", "outer": "plate_harness", "size": 50 } },
    { "id": "smithing.pax", "side": "game", "as": "headThinPax", "continueOnFail": true, "args": { "item": "$headThin.value", "expect": "vanilla" } },
    { "id": "smithing.craft", "side": "game", "as": "bodyBest", "continueOnFail": true, "args": { "slot": "body", "inner": "gambeson_quilted", "middle": "riveted_mail", "outer": "plate_harness" } },
    { "id": "smithing.pax", "side": "game", "as": "bodyBestPax", "continueOnFail": true, "args": { "item": "$bodyBest.value", "expect": "vanilla", "armor": "0/57/25/0", "maxKg": "17" } },
    { "id": "smithing.craft", "side": "game", "as": "bodyFull", "continueOnFail": true, "args": { "slot": "body", "inner": "gambeson_quilted", "middle": "riveted_mail", "outer": "plate_harness", "coverage": "extended", "checkTier": "false" } },
    { "id": "smithing.pax", "side": "game", "as": "bodyFullPax", "continueOnFail": true, "args": { "item": "$bodyFull.value", "expect": "vanilla", "armor": "0/57/25/26", "maxKg": "20" } },
    { "id": "smithing.craft", "side": "game", "as": "bodyTorso", "continueOnFail": true, "args": { "slot": "body", "inner": "gambeson_quilted", "middle": "riveted_mail", "outer": "plate_harness", "coverage": "minimal", "checkTier": "false" } },
    { "id": "smithing.pax", "side": "game", "as": "bodyTorsoPax", "continueOnFail": true, "args": { "item": "$bodyTorso.value", "expect": "vanilla" } },
    { "id": "smithing.craft", "side": "game", "as": "bodyMail", "continueOnFail": true, "args": { "slot": "body", "middle": "chainmail_middle" } },
    { "id": "smithing.pax", "side": "game", "as": "bodyMailPax", "continueOnFail": true, "args": { "item": "$bodyMail.value", "expect": "vanilla" } },
    { "id": "smithing.craft", "side": "game", "as": "bodyThick", "continueOnFail": true, "args": { "slot": "body", "inner": "linen_lining", "outer": "leather_outer", "size": 150 } },
    { "id": "smithing.pax", "side": "game", "as": "bodyThickPax", "continueOnFail": true, "args": { "item": "$bodyThick.value", "expect": "vanilla" } },
    { "id": "smithing.craft", "side": "game", "as": "shouldersBest", "continueOnFail": true, "args": { "slot": "shoulders", "inner": "gambeson_quilted", "middle": "riveted_mail", "outer": "plate_harness", "checkTier": "false" } },
    { "id": "smithing.pax", "side": "game", "as": "shouldersBestPax", "continueOnFail": true, "args": { "item": "$shouldersBest.value", "expect": "vanilla", "armor": "0/18/13/0", "maxKg": "1.7" } },
    { "id": "smithing.craft", "side": "game", "as": "shouldersScale", "continueOnFail": true, "args": { "slot": "shoulders", "middle": "chainmail_middle", "outer": "scale_outer", "checkTier": "false" } },
    { "id": "smithing.pax", "side": "game", "as": "shouldersScalePax", "continueOnFail": true, "args": { "item": "$shouldersScale.value", "expect": "vanilla" } },
    { "id": "smithing.craft", "side": "game", "as": "shouldersThick", "continueOnFail": true, "args": { "slot": "shoulders", "middle": "studded_middle", "outer": "coat_of_plates", "size": 150, "checkTier": "false" } },
    { "id": "smithing.pax", "side": "game", "as": "shouldersThickPax", "continueOnFail": true, "args": { "item": "$shouldersThick.value", "expect": "vanilla" } },
    { "id": "smithing.craft", "side": "game", "as": "handsBest", "continueOnFail": true, "args": { "slot": "hands", "inner": "gambeson_quilted", "middle": "riveted_mail", "outer": "plate_harness" } },
    { "id": "smithing.pax", "side": "game", "as": "handsBestPax", "continueOnFail": true, "args": { "item": "$handsBest.value", "expect": "vanilla", "armor": "0/0/28/0", "maxKg": "1.7" } },
    { "id": "smithing.craft", "side": "game", "as": "handsPlate", "continueOnFail": true, "args": { "slot": "hands", "inner": "padding_heavy", "outer": "plate_harness" } },
    { "id": "smithing.pax", "side": "game", "as": "handsPlatePax", "continueOnFail": true, "args": { "item": "$handsPlate.value", "expect": "vanilla" } },
    { "id": "smithing.craft", "side": "game", "as": "handsThin", "continueOnFail": true, "args": { "slot": "hands", "inner": "gambeson_quilted", "outer": "leather_outer", "size": 50 } },
    { "id": "smithing.pax", "side": "game", "as": "handsThinPax", "continueOnFail": true, "args": { "item": "$handsThin.value", "expect": "vanilla" } },
    { "id": "smithing.craft", "side": "game", "as": "legsBest", "continueOnFail": true, "args": { "slot": "legs", "inner": "gambeson_quilted", "middle": "riveted_mail", "outer": "plate_harness" } },
    { "id": "smithing.pax", "side": "game", "as": "legsBestPax", "continueOnFail": true, "args": { "item": "$legsBest.value", "expect": "vanilla", "armor": "0/0/0/26", "maxKg": "2.6" } },
    { "id": "smithing.craft", "side": "game", "as": "legsLeather", "continueOnFail": true, "args": { "slot": "legs", "inner": "gambeson_quilted", "middle": "leather_middle", "outer": "leather_outer" } },
    { "id": "smithing.pax", "side": "game", "as": "legsLeatherPax", "continueOnFail": true, "args": { "item": "$legsLeather.value", "expect": "vanilla" } },
    { "id": "smithing.craft", "side": "game", "as": "legsThin", "continueOnFail": true, "args": { "slot": "legs", "middle": "brigandine_middle", "outer": "lamellar_outer", "size": 75 } },
    { "id": "smithing.pax", "side": "game", "as": "legsThinPax", "continueOnFail": true, "args": { "item": "$legsThin.value", "expect": "vanilla" } },
    { "id": "smithing.craft", "side": "game", "as": "horse", "continueOnFail": true, "args": { "slot": "horse_armor", "inner": "gambeson_quilted", "middle": "riveted_mail", "outer": "plate_harness" } },
    { "id": "smithing.pax", "side": "game", "as": "horsePax", "continueOnFail": true, "args": { "item": "$horse.value", "expect": "unchanged" } },
    { "id": "smithing.craft", "side": "game", "as": "bow", "continueOnFail": true, "args": { "family": "bow", "slot": "bow", "inner": "bow_limbs_yew", "middle": "bow_riser_maple", "outer": "bow_string_hemp", "checkTier": "false" } },
    { "id": "smithing.pax", "side": "game", "as": "bowPax", "continueOnFail": true, "args": { "item": "$bow.value", "expect": "unchanged" } },
    { "id": "smithing.craft", "side": "game", "as": "crossbow", "continueOnFail": true, "args": { "family": "crossbow", "slot": "crossbow", "inner": "crossbow_prod_steel", "middle": "crossbow_stock_oak", "outer": "crossbow_trigger_iron", "checkTier": "false" } },
    { "id": "smithing.pax", "side": "game", "as": "crossbowPax", "continueOnFail": true, "args": { "item": "$crossbow.value", "expect": "unchanged" } },
    { "id": "smithing.craft", "side": "game", "as": "sling", "continueOnFail": true, "args": { "family": "sling", "slot": "sling", "inner": "sling_pouch_leather", "middle": "sling_cord_flax", "outer": "sling_grip_leather", "checkTier": "false" } },
    { "id": "smithing.pax", "side": "game", "as": "slingPax", "continueOnFail": true, "args": { "item": "$sling.value", "expect": "unchanged" } },
    { "id": "smithing.craft", "side": "game", "as": "shield", "continueOnFail": true, "args": { "family": "shield", "slot": "shield", "inner": "shield_frame_oak", "middle": "shield_rim_iron", "outer": "shield_facing_hide", "extra": "shield_boss_iron", "checkTier": "false" } },
    { "id": "smithing.pax", "side": "game", "as": "shieldPax", "continueOnFail": true, "args": { "item": "$shield.value", "expect": "unchanged" } },
    { "id": "smithing.craft", "side": "game", "as": "arrows", "continueOnFail": true, "args": { "family": "ammo", "slot": "arrow", "inner": "arrow_shaft_hardwood", "middle": "arrow_head_bodkin", "outer": "arrow_fletching_cloth", "extra": "arrow_nock_horn", "batch": 20, "checkTier": "false" } },
    { "id": "smithing.pax", "side": "game", "as": "arrowsPax", "continueOnFail": true, "args": { "item": "$arrows.value", "expect": "unchanged", "batch": 20 } },
    { "id": "smithing.craft", "side": "game", "as": "bolts", "continueOnFail": true, "args": { "family": "ammo", "slot": "bolt", "inner": "bolt_shaft_hardwood", "middle": "bolt_head_bodkin", "outer": "bolt_fletching_leather", "extra": "bolt_nock_horn", "batch": 20, "checkTier": "false" } },
    { "id": "smithing.pax", "side": "game", "as": "boltsPax", "continueOnFail": true, "args": { "item": "$bolts.value", "expect": "unchanged", "batch": 20 } },
    { "id": "smithing.craft", "side": "game", "as": "slingStones", "continueOnFail": true, "args": { "family": "ammo", "slot": "sling_stone", "inner": "sling_bullet_cast", "middle": "sling_shaping_almond", "batch": 20, "checkTier": "false" } },
    { "id": "smithing.pax", "side": "game", "as": "slingStonesPax", "continueOnFail": true, "args": { "item": "$slingStones.value", "expect": "unchanged", "batch": 20 } },
    { "id": "smithing.setSetting", "side": "game", "as": "offAgain", "args": { "name": "pax_vanilla", "value": "false" } },
    { "id": "game.save", "side": "game", "args": { "name": "mltest-smithing-pax" } },
    { "id": "game.toMainMenu", "side": "game", "timeoutSeconds": 300 },
    { "id": "game.loadSave", "side": "game", "timeoutSeconds": 900, "args": { "name": "mltest-smithing-pax" } },
    { "id": "game.pause", "side": "game" },
    { "id": "smithing.itemSame", "side": "game", "as": "headBestBack", "args": { "item": "$headBest.value", "weight": "$headBest.weight", "armor": "$headBest.armor" } },
    { "id": "smithing.itemSame", "side": "game", "as": "bodyFullBack", "args": { "item": "$bodyFull.value", "weight": "$bodyFull.weight", "armor": "$bodyFull.armor" } },
    { "id": "smithing.itemSame", "side": "game", "as": "handsThinBack", "args": { "item": "$handsThin.value", "weight": "$handsThin.weight", "armor": "$handsThin.armor" } },
    { "id": "smithing.itemSame", "side": "game", "as": "offBodyFullBack", "args": { "item": "$off_bodyFull.value", "weight": "$off_bodyFull.weight", "armor": "$off_bodyFull.armor" } },
    { "id": "smithing.oldItemsKeepStats", "side": "game", "args": { "atLeast": 36 } },
    { "id": "smithing.records", "side": "game", "args": { "atLeast": 50 } },
    { "id": "smithing.setSetting", "side": "game", "as": "back", "args": { "name": "pax_vanilla", "value": "$off.before" } },
    { "id": "game.noErrors", "side": "game", "continueOnFail": true }
  ]
}
