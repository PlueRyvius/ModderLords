{
  // The smallest cross-side check: the server changes this player's hero, the player's game must see it. The gold
  // expected is the server's total after the gift, so it holds on a world an earlier suite changed.
  "api": 2,
  "name": "sync-basics",
  "mode": "coop",
  "world": "shared",
  "description": "Gold given to the player's hero on the server reaches the player's game.",
  "steps": [
    { "id": "game.whoAmI", "side": "client:1", "as": "me" },
    { "id": "hero.addGold", "side": "server", "as": "give", "args": { "heroName": "$me.heroName", "amount": 1234 } },
    { "id": "hero.gold", "side": "client:1", "args": { "expected": "$give.gold" } },
    { "compare": "hero.gold", "sides": ["server", "client:1"], "args": { "heroName": "$me.heroName" } }
  ]
}
