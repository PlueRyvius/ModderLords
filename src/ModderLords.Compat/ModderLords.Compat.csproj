<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A Bannerlord module DLL: net472 like every mod, compiled against the official reference assemblies. -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>DedicatedServer.ModderLordsCompat</AssemblyName>
    <RootNamespace>ModderLords.Compat</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>_Module\bin\Win64_Shipping_Server\</OutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Core" Version="1.4.8.119303" ExcludeAssets="runtime" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime" />
  </ItemGroup>


  <ItemGroup>
    <!-- One copy of the terrain diagnostic, compiled into both module assemblies: the server loads this module and a
         client can only load the community one, so the probe has to exist in each. -->
    <Compile Include="..\Shared\TerrainProbe.cs" Link="TerrainProbe.cs" />
  </ItemGroup>

</Project>
