<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ModderLords.CompatSync.Coop</AssemblyName>
    <RootNamespace>ModderLords.CompatSync.Coop</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- The Coop-touching half. NOT a submodule: the engine never eagerly loads it, so its Coop references only have
         to resolve once Coop itself is loaded. ModderLords.CompatSync loads it by hand when Coop is detected. -->
    <OutputPath>..\ModderLords.CompatSync\_Module\bin\Win64_Shipping_Client\</OutputPath>
    <CoopRefDir Condition="'$(CoopRefDir)' == ''">D:\Program Files (x86)\Steam\steamapps\workshop\content\261550\3770450698\bin\Win64_Shipping_Client</CoopRefDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Core" Version="1.4.8.119303" ExcludeAssets="runtime" />
    <ProjectReference Include="..\ModderLords.CompatSync\ModderLords.CompatSync.csproj" Private="false" />
    <Reference Include="Common" HintPath="$(CoopRefDir)\Common.dll" Private="false" />
    <Reference Include="GameInterface" HintPath="$(CoopRefDir)\GameInterface.dll" Private="false" />
    <Reference Include="LiteNetLib" HintPath="$(CoopRefDir)\LiteNetLib.dll" Private="false" />
    <Reference Include="protobuf-net" HintPath="$(CoopRefDir)\protobuf-net.dll" Private="false" />
    <Reference Include="protobuf-net.Core" HintPath="$(CoopRefDir)\protobuf-net.Core.dll" Private="false" />
    <Reference Include="Autofac" HintPath="$(CoopRefDir)\Autofac.dll" Private="false" />
    <!-- Harmony and Newtonsoft ship with the game / the Harmony framework mod; compile-time only. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime" />
    <Reference Include="Newtonsoft.Json" HintPath="$(CoopRefDir)\Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>

  <Target Name="CopyServerBin" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll;$(OutDir)$(AssemblyName).pdb" DestinationFolder="..\ModderLords.CompatSync\_Module\bin\Win64_Shipping_Server\" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>


  <Target Name="RequireCoopAssemblies" BeforeTargets="ResolveReferences" Condition="'$(HasCoopAssemblies)' != 'true'">
    <Error Text="Coop's assemblies were not found. This project builds the coop settings-sync adapter and needs the Bannerlord Coop workshop item (3770450698). Subscribe to it, or pass -p:CoopRefDir=&lt;path to its bin\Win64_Shipping_Client&gt;. The mod loader itself does not need this project." />
  </Target>

</Project>
