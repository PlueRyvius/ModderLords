<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ModderLords.CompatSync</AssemblyName>
    <RootNamespace>ModderLords.CompatSync</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- The submodule DLL. It must reference NOTHING of Coop's: the engine eagerly checks a submodule's references on
         the client (no resolver hook there) and reports "dependency conflict" when one is missing. -->
    <OutputPath>_Module\bin\Win64_Shipping_Client\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Core" Version="1.4.8.119303" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="CopyServerBin" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll;$(OutDir)$(AssemblyName).pdb" DestinationFolder="_Module\bin\Win64_Shipping_Server\" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>


  <ItemGroup>
    <!-- One copy of the terrain diagnostic, compiled into both module assemblies: the server loads this module and a
         client can only load the community one, so the probe has to exist in each. -->
    <Compile Include="..\Shared\TerrainProbe.cs" Link="TerrainProbe.cs" />
  </ItemGroup>

</Project>
