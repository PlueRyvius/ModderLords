<Window x:Class="ModderLords.App.CharacterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ModderLords.App.Localization"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Foreground}"
        Title="{Binding Title}" Height="820" Width="960" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- A changed value is bold, so what Apply will send is visible before it is sent. -->
        <Style x:Key="ChangedRow" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- One relative: a button that opens them here. Women and men get different badge colours, the dead are
             muted with a cross, and relatives outside this hero's clan are italic with their clan named. -->
        <DataTemplate x:Key="RelativeChip">
            <Button Command="{Binding DataContext.OpenRelativeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                    ToolTip="{Binding ToolTip}" Margin="0,0,6,4" Padding="6,2">
                <StackPanel Orientation="Horizontal">
                    <Border Width="20" Height="20" CornerRadius="10" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FF3B6EA8" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Female}" Value="True"><Setter Property="Background" Value="#FFA8457A" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Alive}" Value="False"><Setter Property="Background" Value="#FF777777" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OtherClan}" Value="True"><Setter Property="FontStyle" Value="Italic" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Alive}" Value="False"><Setter Property="Foreground" Value="{DynamicResource MutedForeground}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding Detail, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Button>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="ChipPanel"><WrapPanel /></ItemsPanelTemplate>
    </Window.Resources>
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" Margin="0,0,0,8"
                   Text="{l:T 'Changes are made on the running server and reach the player\&#x27;s game through Coop\&#x27;s own sync. Skill values do not change the character\&#x27;s level; set Level separately if needed. Edits are refused while the player is in a battle or a siege.'}" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{l:T 'Revive…'}" Command="{Binding ReviveCommand}" MinWidth="90" Margin="4,0,8,0" FontWeight="Bold"
                        Visibility="{Binding IsDead, Converter={StaticResource BoolToVis}}"
                        ToolTip="{l:T 'Bring this hero back to life in their home settlement, with full health and their skills rebuilt from their template.'}" />
                <Button Content="{l:T 'Reset perks…'}" Command="{Binding ResetPerksCommand}" MinWidth="100" Margin="4,0,16,0"
                        ToolTip="{l:T 'Take away every perk this character has chosen, so they can be chosen again in the game. Skills, focus and attributes stay.'}" />
                <Button Content="{l:T 'Reload'}" Command="{Binding ReloadCommand}" MinWidth="80" Margin="4,0" />
                <Button Content="{l:T 'Apply'}" Command="{Binding ApplyCommand}" MinWidth="80" Margin="4,0" IsDefault="True" />
                <Button Content="{l:T 'Close'}" IsCancel="True" Click="Close_Click" MinWidth="80" Margin="4,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
        <TabControl>
            <TabItem Header="{l:T 'Character'}">
                <DockPanel Margin="4">
                    <!-- APPEARANCE: gender and the game's BodyProperties text (appearance DNA). -->
                    <GroupBox DockPanel.Dock="Top" Header="{l:T 'Appearance'}" Margin="0,0,0,8" Padding="6,4">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{l:T 'Gender'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding Genders}" SelectedIndex="{Binding GenderIndex}" Width="100">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGenderChanged}" Value="True"><Setter Property="FontWeight" Value="Bold" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                                <TextBlock Text="{l:T 'Copy face from'}" VerticalAlignment="Center" Margin="20,0,6,0" />
                                <ComboBox ItemsSource="{Binding FaceSources}" SelectedItem="{Binding FaceSource}" Width="240" />
                                <Button Content="{l:T 'Copy face'}" Command="{Binding CopyFaceFromCommand}" Margin="4,0,0,0"
                                        ToolTip="{l:T 'Put that hero\&#x27;s appearance DNA in the box below. Nothing changes until Apply.'}" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{l:T 'Library'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding LibraryFaces}" SelectedItem="{Binding LibraryFace}" Width="220"
                                      ToolTip="{l:T 'Faces you saved, kept on this PC for every server'}" />
                            <Button Content="{l:T 'Use'}" Command="{Binding UseLibraryFaceCommand}" MinWidth="50" Margin="4,0,0,0"
                                    ToolTip="{l:T 'Put the saved face in the box above. Nothing changes until Apply.'}" />
                            <Button Content="{l:T 'Delete'}" Command="{Binding DeleteLibraryFaceCommand}" MinWidth="60" Margin="4,0,0,0" />
                            <TextBlock Text="{l:T 'Save as'}" VerticalAlignment="Center" Margin="20,0,6,0" />
                            <TextBox Text="{Binding LibraryName, UpdateSourceTrigger=PropertyChanged}" Width="180" MaxLength="60"
                                     ToolTip="{l:T 'A name for the DNA in the box above, e.g. Viking jarl'}" />
                            <Button Content="{l:T 'Save'}" Command="{Binding SaveToLibraryCommand}" MinWidth="60" Margin="4,0,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="{l:T 'Copy'}" Command="{Binding CopyBodyCommand}" MinWidth="60" ToolTip="{l:T 'Copy the DNA to the clipboard (the game\&#x27;s character editor pastes it with Ctrl+V)'}" />
                                <Button Content="{l:T 'Paste'}" Command="{Binding PasteBodyCommand}" MinWidth="60" Margin="4,0,0,0" ToolTip="{l:T 'Use DNA from the clipboard (the game\&#x27;s character editor copies it with Ctrl+C)'}" />
                                <Button Content="{l:T 'Export…'}" Command="{Binding ExportBodyCommand}" MinWidth="70" Margin="12,0,0,0" />
                                <Button Content="{l:T 'Import…'}" Command="{Binding ImportBodyCommand}" MinWidth="70" Margin="4,0,0,0" />
                                <TextBlock Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                                           Text="{l:T 'Face, hair, weight and build. The age in the DNA is not used; set Age in the list below.'}" />
                            </StackPanel>
                            <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Height="44"
                                     VerticalScrollBarVisibility="Auto">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBodyChanged}" Value="True"><Setter Property="FontWeight" Value="Bold" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </DockPanel>
                    </GroupBox>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Left" Text="{l:T 'Name'}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="40">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNameChanged}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Values}" AutoGenerateColumns="False" RowHeaderWidth="0" CanUserAddRows="False" CanUserDeleteRows="False" RowStyle="{StaticResource ChangedRow}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:T 'Value'}" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                                    <DataGridTextColumn Header="{l:T 'Now'}" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                    <DataGridTextColumn Header="{l:T 'Was'}" Binding="{Binding Original}" IsReadOnly="True" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2" Text="{l:T 'Attributes'}" FontWeight="Bold" Margin="0,10,0,4" />
                            <DataGrid Grid.Row="3" ItemsSource="{Binding Attributes}" AutoGenerateColumns="False" RowHeaderWidth="0" CanUserAddRows="False" CanUserDeleteRows="False" RowStyle="{StaticResource ChangedRow}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:T 'Attribute'}" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                                    <DataGridTextColumn Header="{l:T 'Now'}" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                    <DataGridTextColumn Header="{l:T 'Was'}" Binding="{Binding Original}" IsReadOnly="True" Width="50" />
                                    <DataGridTextColumn Header="{l:T 'Range'}" Binding="{Binding Range}" IsReadOnly="True" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DockPanel Grid.Row="4" Margin="0,10,0,4">
                                <CheckBox DockPanel.Dock="Right" Content="{l:T 'Show hidden traits'}" IsChecked="{Binding ShowHiddenTraits}"
                                          ToolTip="{l:T 'Traits the game keeps for its own bookkeeping (mostly for NPCs). Change them only if you know what one does.'}" />
                                <TextBlock Text="{l:T 'Traits'}" FontWeight="Bold" />
                            </DockPanel>
                            <DataGrid Grid.Row="5" ItemsSource="{Binding TraitsView}" AutoGenerateColumns="False" RowHeaderWidth="0" CanUserAddRows="False" CanUserDeleteRows="False" RowStyle="{StaticResource ChangedRow}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:T 'Trait'}" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                                    <DataGridTextColumn Header="{l:T 'Now'}" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                    <DataGridTextColumn Header="{l:T 'Was'}" Binding="{Binding Original}" IsReadOnly="True" Width="50" />
                                    <DataGridTextColumn Header="{l:T 'Range'}" Binding="{Binding Range}" IsReadOnly="True" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="{l:T 'Skills'}" FontWeight="Bold" Margin="0,0,0,4" />
                            <DataGrid ItemsSource="{Binding Skills}" AutoGenerateColumns="False" RowHeaderWidth="0" CanUserAddRows="False" CanUserDeleteRows="False" RowStyle="{StaticResource ChangedRow}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:T 'Skill'}" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                                    <DataGridTextColumn Header="{l:T 'Attribute'}" Binding="{Binding Attribute}" IsReadOnly="True" Width="100" />
                                    <DataGridTextColumn Header="{l:T 'Level'}" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                    <DataGridTextColumn Header="{l:T 'Was'}" Binding="{Binding OriginalValue}" IsReadOnly="True" Width="45" />
                                    <DataGridTextColumn Header="{l:T 'Focus'}" Binding="{Binding Focus, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                                    <DataGridTextColumn Header="{l:T 'Was'}" Binding="{Binding OriginalFocus}" IsReadOnly="True" Width="45" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="{l:T 'Family'}">
                <!-- The hero on show in the middle: parents above, siblings to the left, spouse to the right, children below.
                     Click anyone to edit them here; Back returns. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <DockPanel Margin="8">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button DockPanel.Dock="Left" Content="{l:T '&#x2190; Back'}" Command="{Binding BackCommand}"
                                    ToolTip="{l:T 'Back to the hero you were editing before this one'}" />
                            <TextBlock Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                                       Text="{l:T 'Click a relative to edit them in this window. Blue: men, pink: women, grey: dead. Italic: outside this hero\&#x27;s clan (its name is shown).'}" />
                        </DockPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{l:T 'Parents'}" HorizontalAlignment="Center" Foreground="{DynamicResource MutedForeground}" />
                            <ItemsControl ItemsSource="{Binding Parents}" ItemTemplate="{StaticResource RelativeChip}" ItemsPanel="{StaticResource ChipPanel}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            <TextBlock Text="&#x2502;" HorizontalAlignment="Center" FontSize="18" Foreground="{DynamicResource MutedForeground}" />
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Siblings'}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedForeground}" />
                                    <ItemsControl ItemsSource="{Binding Siblings}" ItemTemplate="{StaticResource RelativeChip}" ItemsPanel="{StaticResource ChipPanel}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" BorderThickness="2" BorderBrush="{DynamicResource SelectionBackground}" CornerRadius="4" Padding="12,6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OriginalName}" FontWeight="Bold" FontSize="14" />
                                </Border>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Left" Margin="16,0,0,0">
                                    <TextBlock Text="{l:T 'Spouse'}" Foreground="{DynamicResource MutedForeground}" />
                                    <ItemsControl ItemsSource="{Binding Spouses}" ItemTemplate="{StaticResource RelativeChip}" ItemsPanel="{StaticResource ChipPanel}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="&#x2502;" HorizontalAlignment="Center" FontSize="18" Foreground="{DynamicResource MutedForeground}" />
                            <TextBlock Text="{l:T 'Children'}" HorizontalAlignment="Center" Foreground="{DynamicResource MutedForeground}" />
                            <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{StaticResource RelativeChip}" ItemsPanel="{StaticResource ChipPanel}" HorizontalAlignment="Center" Margin="0,4,0,0" MaxWidth="820" />

                            <!-- FAMILY ACTIONS: each asks first, goes through the game's own code where it has some, and reloads the hero. -->
                            <GroupBox Header="{l:T 'Change the family'}" Margin="0,24,0,0" Padding="8,6" MinWidth="760">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Text="{l:T 'Find a hero'}" VerticalAlignment="Center" Width="90" />
                                        <Button DockPanel.Dock="Right" Content="{l:T 'Search'}" Command="{Binding SearchHeroesCommand}" MinWidth="70" Margin="4,0,0,0" />
                                        <TextBox Text="{Binding HeroSearch, UpdateSourceTrigger=PropertyChanged}" Width="220" HorizontalAlignment="Left"
                                                 ToolTip="{l:T 'Part of a name (living and dead heroes in the whole world), or leave it empty to list every living lord and lady'}" />
                                        <ComboBox ItemsSource="{Binding HeroResults}" SelectedItem="{Binding PickedHero}" DisplayMemberPath="Display" Margin="8,0,0,0" MinWidth="300" />
                                    </DockPanel>
                                    <WrapPanel Margin="90,0,0,10">
                                        <Button Content="{l:T 'Marry them'}" Command="{Binding MarryCommand}" Margin="0,0,6,4" Padding="8,2"
                                                ToolTip="{l:T 'The game\&#x27;s own wedding: it checks age, sex, kinship and clan rules, and picks the clan they live in'}" />
                                        <Button Content="{l:T 'Make them the father'}" Command="{Binding SetFatherCommand}" Margin="0,0,6,4" Padding="8,2" />
                                        <Button Content="{l:T 'Make them the mother'}" Command="{Binding SetMotherCommand}" Margin="0,0,6,4" Padding="8,2" />
                                        <Button Content="{l:T 'Let them adopt'}" Command="{Binding AdoptCommand}" Margin="0,0,6,4" Padding="8,2"
                                                ToolTip="{l:T 'They become this hero\&#x27;s parent, and this hero moves into their clan'}" />
                                    </WrapPanel>
                                    <WrapPanel Margin="90,0,0,10">
                                        <Button Content="{l:T 'Divorce'}" Command="{Binding DivorceCommand}" Margin="0,0,6,4" Padding="8,2" />
                                        <Button Content="{l:T 'Remove father'}" Command="{Binding ClearFatherCommand}" Margin="0,0,6,4" Padding="8,2" />
                                        <Button Content="{l:T 'Remove mother'}" Command="{Binding ClearMotherCommand}" Margin="0,0,6,4" Padding="8,2" />
                                    </WrapPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{l:T 'Move to clan'}" VerticalAlignment="Center" Width="90" />
                                        <Button DockPanel.Dock="Right" Content="{l:T 'Move'}" Command="{Binding MoveToClanCommand}" MinWidth="70" Margin="4,0,0,0" />
                                        <TextBox Text="{Binding ClanSearch, UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left"
                                                 ToolTip="{l:T 'Part of a clan name, or empty for every clan'}" />
                                        <Button Content="{l:T 'Find'}" Command="{Binding SearchClansCommand}" MinWidth="50" Margin="4,0,0,0" />
                                        <ComboBox ItemsSource="{Binding ClanResults}" SelectedItem="{Binding PickedClan}" DisplayMemberPath="Name" Margin="8,0,0,0" MinWidth="240" />
                                    </DockPanel>
                                    <TextBlock Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="740" HorizontalAlignment="Left"
                                               Text="{l:T 'Clan leaders, companions and players\&#x27; own heroes cannot be moved to another clan. Each change asks first and is synced to every player.'}" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </DockPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
