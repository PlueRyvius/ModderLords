<Window x:Class="ModderLords.App.CharacterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Foreground}"
        Title="{Binding Title}" Height="720" Width="900" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <!-- A changed value is bold, so what Apply will send is visible before it is sent. -->
        <Style x:Key="ChangedRow" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" Margin="0,0,0,8"
                   Text="Changes are made on the running server and reach the player's game through Coop's own sync. Skills are set to exactly the value typed and do not change the character's level. Edits are refused while the player is in a battle or a siege." />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Reload" Command="{Binding ReloadCommand}" MinWidth="80" Margin="4,0" />
                <Button Content="Apply" Command="{Binding ApplyCommand}" MinWidth="80" Margin="4,0" IsDefault="True" />
                <Button Content="Close" IsCancel="True" MinWidth="80" Margin="4,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Character" FontWeight="Bold" Margin="0,0,0,4" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding Values}" AutoGenerateColumns="False" RowHeaderWidth="0" CanUserAddRows="False" CanUserDeleteRows="False" RowStyle="{StaticResource ChangedRow}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Value" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="Now" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                        <DataGridTextColumn Header="Was" Binding="{Binding Original}" IsReadOnly="True" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="2" Text="Attributes" FontWeight="Bold" Margin="0,10,0,4" />
                <DataGrid Grid.Row="3" ItemsSource="{Binding Attributes}" AutoGenerateColumns="False" RowHeaderWidth="0" CanUserAddRows="False" CanUserDeleteRows="False" RowStyle="{StaticResource ChangedRow}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Attribute" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="Now" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                        <DataGridTextColumn Header="Was" Binding="{Binding Original}" IsReadOnly="True" Width="50" />
                        <DataGridTextColumn Header="Range" Binding="{Binding Range}" IsReadOnly="True" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel Grid.Row="4" Margin="0,10,0,4">
                    <CheckBox DockPanel.Dock="Right" Content="Show hidden traits" IsChecked="{Binding ShowHiddenTraits}"
                              ToolTip="Traits the game keeps for its own bookkeeping (mostly for NPCs). Change them only if you know what one does." />
                    <TextBlock Text="Traits" FontWeight="Bold" />
                </DockPanel>
                <DataGrid Grid.Row="5" ItemsSource="{Binding TraitsView}" AutoGenerateColumns="False" RowHeaderWidth="0" CanUserAddRows="False" CanUserDeleteRows="False" RowStyle="{StaticResource ChangedRow}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Trait" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="Now" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                        <DataGridTextColumn Header="Was" Binding="{Binding Original}" IsReadOnly="True" Width="50" />
                        <DataGridTextColumn Header="Range" Binding="{Binding Range}" IsReadOnly="True" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Skills" FontWeight="Bold" Margin="0,0,0,4" />
                <DataGrid ItemsSource="{Binding Skills}" AutoGenerateColumns="False" RowHeaderWidth="0" CanUserAddRows="False" CanUserDeleteRows="False" RowStyle="{StaticResource ChangedRow}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Skill" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="Attribute" Binding="{Binding Attribute}" IsReadOnly="True" Width="100" />
                        <DataGridTextColumn Header="Level" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                        <DataGridTextColumn Header="Was" Binding="{Binding OriginalValue}" IsReadOnly="True" Width="45" />
                        <DataGridTextColumn Header="Focus" Binding="{Binding Focus, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                        <DataGridTextColumn Header="Was" Binding="{Binding OriginalFocus}" IsReadOnly="True" Width="45" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
