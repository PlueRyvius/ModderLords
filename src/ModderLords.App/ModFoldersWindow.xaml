<Window x:Class="ModderLords.App.ModFoldersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ModderLords.App.ViewModels"
        Title="Folders: server and client" SizeToContent="Height" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Foreground}">
    <StackPanel Margin="16">
        <TextBlock x:Name="Header" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" Margin="0,0,0,8" />
        <TextBlock x:Name="EmptyText" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"
                   Text="This mod has no folders to choose between." />
        <!-- The height is capped here, not on the window: a mod with dozens of folders scrolls inside the grid and
             the buttons stay on screen. -->
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" CanUserReorderColumns="False" RowHeaderWidth="0" HeadersVisibility="Column"
                  MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Folder" Binding="{Binding Name}" IsReadOnly="True" Width="170" />
                <DataGridTemplateColumn Header="Used by" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{x:Static vm:ModFolderRow.Labels}"
                                      SelectedItem="{Binding Choice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanChange}" Margin="0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" IsReadOnly="True" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" Click="Ok" MinWidth="80" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
