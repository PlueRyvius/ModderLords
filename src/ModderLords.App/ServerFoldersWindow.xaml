<Window x:Class="ModderLords.App.ServerFoldersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folders to leave out on the server" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <CheckBox x:Name="UseRecordBox" Margin="0,0,0,8" Checked="UseRecordChanged" Unchecked="UseRecordChanged" />
        <TextBox x:Name="FoldersBox" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                 MinHeight="96" MaxHeight="220" TextChanged="FoldersChanged" />
        <TextBlock x:Name="HintText" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Click="Ok" MinWidth="80" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
