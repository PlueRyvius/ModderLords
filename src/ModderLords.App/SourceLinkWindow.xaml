<Window x:Class="ModderLords.App.SourceLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download link" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="LinkBox" TextChanged="LinkChanged" />
        <TextBlock x:Name="HintText" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" Click="Ok" MinWidth="80" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
