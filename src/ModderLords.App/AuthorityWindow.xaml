<Window x:Class="ModderLords.App.AuthorityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Foreground}"
        Title="Authority" Height="620" Width="1080" MinHeight="360" MinWidth="640" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" x:Name="Header" FontWeight="Bold" Margin="0,0,0,2" TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top" x:Name="SubHeader" Foreground="{DynamicResource MutedForeground}" Margin="0,0,0,6" TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" Margin="0,0,0,8"
                   Text="Read from the mod's code, nothing is run. ServerOnly and NeedsStateSync: skipped on players' clients when Server-only logic is ticked. LeakingPostfix: removed on clients. NeedsRelay: a player action that silently does nothing for players. Review: the code alone does not decide it. AlreadyHandled, Both and Local need nothing." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <CheckBox x:Name="ShowAll" Content="Show every entry point" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed" IsEnabled="False" />
            <TextBlock x:Name="CopyStatus" VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource MutedForeground}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CopyButton" Content="Copy report" Click="Copy_Click" MinWidth="110" Margin="4,0" IsEnabled="False"
                    ToolTip="Copy the full report as JSON (every entry point, with reasons and call paths)" />
            <Button Content="Close" IsCancel="True" Click="Close_Click" MinWidth="80" Margin="4,0" />
        </StackPanel>
        <TextBox DockPanel.Dock="Bottom" x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" Height="110" Margin="0,8,0,0"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeaderWidth="0"
                  HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="120" />
                <DataGridTextColumn Header="Trigger" Binding="{Binding Trigger}" Width="95" />
                <DataGridTextColumn Header="Entry point" Binding="{Binding Entry}" Width="300" />
                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
