<UserControl x:Class="ModderLords.App.Controls.Sparkline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="46" ClipToBounds="True">
    <Canvas Background="Transparent">
        <!-- The session's normal range, drawn behind the line so "is this unusual?" is answerable at a glance. -->
        <Rectangle x:Name="Band" Canvas.Left="0" Fill="{DynamicResource WarningBackground}" Opacity="0.55" Visibility="Collapsed" />
        <Polyline x:Name="Line" Stroke="{DynamicResource Foreground}" StrokeThickness="1.4"
                  StrokeLineJoin="Round" />
    </Canvas>
</UserControl>
