<Window x:Class="ModderLords.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ModderLords.App.Localization"
        xmlns:vm="clr-namespace:ModderLords.App.ViewModels"
        xmlns:logs="clr-namespace:ModderLords.Core.Logs;assembly=ModderLords.Core"
        xmlns:compat="clr-namespace:ModderLords.Core.Compat;assembly=ModderLords.Core"
        xmlns:controls="clr-namespace:ModderLords.App.Controls"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Foreground}"
        Title="ModderLords" Height="820" Width="1280" MinWidth="960" MinHeight="600"
        Icon="pack://application:,,,/ModderLords;component/appicon.ico"
        Closing="Window_Closing">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vm:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <vm:HostColumnWidthConverter x:Key="HostColumnWidth" />
    </Window.Resources>

    <DockPanel>
        <!-- top bar: profile + launch -->
        <Border DockPanel.Dock="Top" Padding="8" Background="{DynamicResource ChromeBackground}">
            <!-- The right-hand group is docked FIRST. A DockPanel sizes its children in order, so when the profile
                 buttons came first they took their full width and the launch buttons were drawn over them at the
                 minimum window width ("Re-sync junctions" covered the mode button, and the status had zero width).
                 Now the launch group always gets its space and the profile buttons wrap onto a second row instead.
                 The status line lives in the bottom bar, where there is room for it. -->
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" DockPanel.Dock="Right">
                    <!-- Hidden: everyone runs in Host mode (see the MainWindow constructor). The button and its
                         handler are kept so the switch can be brought back by removing the Visibility. -->
                    <Button x:Name="ModeButton" Content="{l:T 'Host mode'}" Click="Mode_Click" MinWidth="92" Margin="4,0,4,0"
                            Visibility="Collapsed" />
                    <Button Content="{l:T 'Report a problem…'}" Click="ReportProblem_Click" MinWidth="116" Margin="4,0"
                            ToolTip="{l:T 'Create a private-on-this-PC, redacted support ZIP, then open the public GitHub bug-report form. Nothing is uploaded automatically.'}" />
                    <Button Content="{l:T 'Updates'}" Command="{Binding Update.CheckNowCommand}" MinWidth="64" Margin="4,0,4,0"
                            ToolTip="{l:T 'Check GitHub for a newer ModderLords release now. Nothing is downloaded unless you then click Update now.'}" />
                    <Button x:Name="ThemeButton" Content="{l:T 'Dark'}" Click="Theme_Click" MinWidth="52" Margin="4,0,4,0"
                            ToolTip="{l:T 'Switch between the light and dark theme'}" />
                    <!-- Player mode launches the mods you picked; Host mode launches the game that joins the server
                         you are running, which is why the wording and the tooltip change with the mode. -->
                    <Button Command="{Binding LaunchClientCommand}" Margin="4,0,20,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="{l:T 'Play'}" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Background" Value="{DynamicResource SuccessBackground}" />
                                <Setter Property="ToolTip" Value="{l:T 'Start Bannerlord with exactly the mods this profile enables, in this order. Your TaleWorlds launcher mod list is not touched.'}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHost}" Value="True">
                                        <Setter Property="Content" Value="{l:T 'Launch client'}" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
                                        <Setter Property="ToolTip" Value="{l:T 'Start Bannerlord from the game folder, with its mod list matched to the server. Steam\&#x27;s Play button is blocked while the coop server is running, because the Coop mod logs the server on to Steam as a game server; starting the exe here is not blocked.'}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{l:T 'Launch server'}" Command="{Binding Host.LaunchCommand}" FontWeight="Bold" Background="{DynamicResource SuccessBackground}"
                            Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" />
                    <Button Content="{l:T 'Stop'}" Command="{Binding Host.StopCommand}" Background="{DynamicResource DangerBackground}"
                            Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:T 'Profile'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="160" ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfileName}" DropDownOpened="Profiles_DropDownOpened" />
                    </StackPanel>
                    <Button Content="{l:T 'New'}" Command="{Binding NewProfileCommand}" />
                    <Button Content="{l:T 'Save'}" Command="{Binding SaveProfileCommand}" />
                    <Button Content="{l:T 'Rename'}" Command="{Binding RenameProfileCommand}"
                            ToolTip="{l:T 'Rename this profile. Its settings, its saved mod-setting overrides and its overlay folder move with it.'}" />
                    <Button Content="{l:T 'Delete'}" Command="{Binding DeleteProfileCommand}" />
                    <Button Content="{l:T 'Rescan mods'}" Command="{Binding RescanCommand}" />
                    <Button Content="{l:T 'Folders…'}" Command="{Binding EditFoldersCommand}"
                            ToolTip="{l:T 'Choose where this profile finds the game, the coop server and any extra mod folders. Needed only when they are not found automatically.'}" />
                    <Button Content="{l:T 'Re-sync junctions'}" Command="{Binding Host.ResyncCommand}" Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}"
                            ToolTip="{l:T 'Recreate the links under engine\\Modules (after a workshop update or a Steam re-download of the server)'}" />
                </WrapPanel>
                <TextBlock Text="{Binding Host.CreationProgressText}" VerticalAlignment="Center" Margin="8,0" FontStyle="Italic"
                           Foreground="{DynamicResource MutedForeground}" TextWrapping="NoWrap"
                           Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" />
            </DockPanel>
        </Border>

        <!-- drift banner -->
        <Border DockPanel.Dock="Top" Padding="8,6" Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Host.DriftText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        <!-- Player mode has no Host, so the binding is null rather than empty and matches neither
                             the trigger above nor anything else: say so explicitly. -->
                        <DataTrigger Binding="{Binding Host.DriftText}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Host.DriftText}" TextWrapping="Wrap" />
        </Border>

        <!-- blocked-mod banner: Windows refuses to load assemblies extracted from a zip that was never unblocked,
             and it does so silently, so the player sees enabled mods that simply do nothing. Clearing the mark needs
             no elevation and undoes nothing, but it still touches their install, so it waits for the button. -->
        <Border DockPanel.Dock="Top" Padding="8,6" Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="0,0,0,1"
                Visibility="{Binding HasBlockedFiles, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:T 'Unblock them'}" Command="{Binding UnblockModsCommand}" Margin="8,0,0,0" Padding="10,2" />
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                    <Run Text="{l:T 'Windows is blocking'}" /><Run Text=" " /><Run Text="{Binding BlockedFileCount, Mode=OneWay}" /><Run
                        Text="{l:T ' file(s) in enabled mods, so the game loads their folders but none of their code. This is what an unblocked download looks like. See Messages for which mods.'}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- update banner: only there when a newer release was found. Nothing downloads until "Update now". -->
        <Border DockPanel.Dock="Top" Padding="8,6" Background="{DynamicResource SuccessBackground}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="0,0,0,1"
                Visibility="{Binding Update.HasUpdate, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding Update.ProgressText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="{l:T 'What\&#x27;s new'}" Command="{Binding Update.ShowNotesCommand}" />
                    <Button Content="{l:T 'Update now'}" Command="{Binding Update.UpdateNowCommand}" FontWeight="Bold"
                            ToolTip="{l:T 'Download the new version, check it against its published checksum, replace this copy and restart. Your profiles are kept.'}" />
                    <Button Content="{l:T 'Later'}" Command="{Binding Update.LaterCommand}" ToolTip="{l:T 'Hide this until ModderLords is next started'}" />
                    <Button Content="{l:T 'Skip this version'}" Command="{Binding Update.SkipCommand}" ToolTip="{l:T 'Do not mention this version again; a later one will still be offered'}" />
                </StackPanel>
                <TextBlock Text="{Binding Update.BannerText}" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="Bold" />
            </DockPanel>
        </Border>

        <!-- status bar -->
        <Border DockPanel.Dock="Bottom" Padding="8,4" Background="{DynamicResource ChromeBackground}">
            <DockPanel>
                <!-- Support link. The mark keeps its brand colours in both themes, so it sits on its own
                     light chip rather than vanishing into a dark background. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <!-- Language. A globe, because the picker has to be findable by someone who cannot read the current
                         language; the names are written in their own language for the same reason. Takes effect on restart. -->
                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource LogTool}" Margin="0,0,6,0" />
                    <ComboBox x:Name="LanguageBox" SelectionChanged="Language_SelectionChanged" MinWidth="110" Margin="0,0,16,0"
                              VerticalAlignment="Center"
                              ToolTip="{l:T 'Language of the app. Takes effect when ModderLords is restarted.'}" />
                    <Border Background="{StaticResource BmcChip}" CornerRadius="4" Padding="4,3" VerticalAlignment="Center">
                        <Viewbox Width="15" Height="21">
                            <Canvas Width="27" Height="39">
                                <Path Data="{StaticResource BmcCupGeometry}" Fill="{StaticResource BmcYellow}" />
                                <Path Data="{StaticResource BmcOutlineGeometry}" Fill="{StaticResource BmcDark}" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock VerticalAlignment="Center" Margin="6,0,0,0">
                        <Hyperlink NavigateUri="https://buymeacoffee.com/ryvius" RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{DynamicResource LogTool}"
                                   ToolTip="{l:T 'Opens buymeacoffee.com/ryvius in your browser'}">Buy me a coffee</Hyperlink>
                    </TextBlock>
                </StackPanel>
                <StackPanel>
                    <!-- The one-line status. It used to squeeze into the top bar beside the buttons and had no width at
                         all once they grew; here it always has the full width of the window. -->
                    <TextBlock Text="{Binding Status}" FontStyle="Italic" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="0,0,0,2" />
                    <TextBlock Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}"><Run Text="{l:T 'Server: '}" FontWeight="Bold" /><Run Text="{Binding ServerRoot}" /></TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock><Run Text="{l:T 'Game:   '}" FontWeight="Bold" /><Run Text="{Binding GameRoot}" /></TextBlock>
                        <!-- The fix, right where the problem is reported. Only there when the install was not found. -->
                        <TextBlock Margin="10,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GameRoot}" Value="(game install not found)">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Hyperlink Command="{Binding EditFoldersCommand}" Foreground="{DynamicResource LogTool}">Set game folder…</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="8" SelectionChanged="Tabs_SelectionChanged">
            <!-- MODS -->
            <TabItem Header="{l:T 'Mods'}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="360" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="ModsSidebarColumn" Width="300" MinWidth="220" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <!-- Wraps rather than clips: Host mode adds the compat buttons and the role legend, which ran
                             off the right-hand edge at the minimum window width. -->
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button Content="{l:T 'Move up'}" Command="{Binding MoveUpCommand}" />
                            <Button Content="{l:T 'Move down'}" Command="{Binding MoveDownCommand}" />
                            <Button Content="{l:T 'Refresh order'}" Command="{Binding RefreshPreviewCommand}" />
                            <!-- Only there when the profile actually holds the arrangement that crashes the game. -->
                            <Button Content="{l:T 'Fix load order'}" Command="{Binding FixCoopOrderCommand}"
                                    Background="{DynamicResource WarningBackground}"
                                    ToolTip="{Binding CoopOrderWarning}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CoopOrderWarning}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Only there when it has something to do: a deleted mod otherwise stays on the list forever. -->
                            <Button Command="{Binding RemoveAllMissingCommand}" Background="{DynamicResource WarningBackground}"
                                    ToolTip="{l:T 'Take every mod that is no longer installed off this profile\&#x27;s list. You are asked first.'}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Content" Value="{Binding MissingCount}" />
                                        <Setter Property="ContentStringFormat" Value="Remove missing ({0})" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MissingCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{l:T 'Analyze operations…'}" Command="{Binding AnalyzeOperationsCommand}" Margin="8,0,0,0" ToolTip="{l:T 'Inspect operation authority, player interaction, provider contracts, and unresolved replication'}" />
                            <CheckBox Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" Content="{l:T 'Automatic validated contracts'}" IsChecked="{Binding Profile.AutomaticCompatibility}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{l:T 'Only matching contracts that passed offline and integration validation can activate'}" />
                            <Button Content="{l:T 'Use engine order'}" Command="{Binding UseEngineOrderCommand}"
                                    ToolTip="{l:T 'Sort this list into the order the engine actually loads (shown on the right). Only mods that a manifest forces to move are moved; the rest keep the place you gave them.'}" />
                            <!-- The computed order is assembled from module metadata, and metadata is sometimes wrong
                                 (TAOM_Map declares that TAOM loads before it, contradicting its own authors' published
                                 order). No dependency logic covers every case, so the user has to be able to win. -->
                            <CheckBox Content="{l:T 'My order wins'}" IsChecked="{Binding ManualLoadOrder}" VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="{l:T 'Use this list exactly as written, even where a mod\&#x27;s manifest declares a different order. Conflicts are still listed under the order preview, so you can see what you are overriding. Leave off unless a mod\&#x27;s declared order is wrong.'}" />
                            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource MutedForeground}"
                                       ToolTip="{l:T 'Frameworks declare that the game\&#x27;s own modules load after them, so they sit above the game and cannot be moved below it. The game\&#x27;s own modules are placed by the engine.'}"
                                       Text="{l:T 'Drag to reorder within Frameworks / Game / Mods'}" />
                            <Button Content="{l:T 'Behaviours…'}" Command="{Binding EditBehaviorsCommand}" ToolTip="{l:T 'Choose which of the selected mod\&#x27;s behaviours run on the server only'}"
                                    Visibility="{Binding ShowExperimentalCompat, Converter={StaticResource BoolToVis}}" />
                            <Button Content="{l:T 'Authority…'}" Command="{Binding ShowAuthorityCommand}" ToolTip="{l:T 'Read the selected mod\&#x27;s code and show which parts must run on the server only, which need nothing, and which need a closer look'}"
                                    Visibility="{Binding ShowExperimentalCompat, Converter={StaticResource BoolToVis}}" />
                            <Button Content="{l:T 'Record…'}" Command="{Binding RecordCompatCommand}" Margin="12,0,0,0" ToolTip="{l:T 'Record how the selected mod behaves under Coop (verdict, notes, defaults). Saved to your local compat database.'}"
                                    Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" />
                            <Button Content="{l:T 'Export…'}" Command="{Binding ExportCompatCommand}" ToolTip="{l:T 'Write the selected mod\&#x27;s record (or all your local records) to a file you can share'}"
                                    Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" />
                            <Button Content="{l:T 'Submit…'}" Command="{Binding SubmitCompatCommand}" ToolTip="{l:T 'Send the selected mod\&#x27;s settings (role and folders) to the maintainer as a compatibility record: opens a prefilled GitHub issue in your browser. Works once a player has joined a server hosted with them, or for a record you wrote with Record…. When other mods are ready too, it offers to send them all in the same issue. Nothing is posted until you press Submit there.'}"
                                    Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" />
                            <Button Content="{l:T 'Import…'}" Command="{Binding ImportCompatCommand}" ToolTip="{l:T 'Merge a shared record file into your local compat database (newer records win)'}"
                                    Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" />
                            <TextBlock VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource MutedForeground}"
                                       Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}"
                                       TextWrapping="Wrap"
                                       ToolTip="{l:T 'Server + Client: the mod\&#x27;s code loads on the server and on players\&#x27; games. The usual choice for gameplay mods.&#x0a;Client only: the server keeps the mod in its list so players can join, but loads none of its code. For UI frameworks such as Harmony, ButterLib, UIExtenderEx and MCM.&#x0a;Client optional: the mod is not on the server at all, and each player chooses whether to run it. Only for mods that change what one player sees (overlays, camera, interface); a gameplay mod set this way will put players out of step. Needs Settings sync.&#x0a;Mod decides: the mod\&#x27;s own manifest says what the server loads. Only for mods built for dedicated servers.&#x0a;Server only: the mod\&#x27;s behaviours run on the server and players\&#x27; games skip them. Experimental, so it is offered only with Experimental compatibility on (Server tab, Advanced), and it needs Settings sync.'}"
                                       Text="{l:T 'Role: Server + Client runs the mod\&#x27;s code on the server and on players\&#x27; games; Client only runs it on players\&#x27; games only (UI frameworks); Client optional lets each player choose whether to run it (overlays and other visual mods); Mod decides leaves it to the mod\&#x27;s own manifest. Server only appears with Experimental compatibility on.'}" />
                        </WrapPanel>
                        <!-- CanUserSortColumns is OFF and must stay off. This list IS the load order: the row order
                             is the thing being edited, and a column sort silently decouples what you see from the
                             collection underneath, so Move up/down and dragging act on rows other than the ones you
                             are looking at. That is exactly what it did before this was set. -->
                        <DataGrid x:Name="ModsGrid" ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserSortColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                                  PreviewMouseLeftButtonDown="ModsGrid_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="ModsGrid_PreviewMouseMove" Drop="ModsGrid_Drop" DragOver="ModsGrid_DragOver"
                                  DragLeave="ModsGrid_DragLeave"
                                  PreviewMouseRightButtonDown="ModsGrid_PreviewMouseRightButtonDown" KeyDown="ModsGrid_KeyDown"
                                  AllowDrop="True">
                            <!-- A ContextMenu takes its DataContext from the grid, so these bind straight to the view model. -->
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{l:T 'Remove from profile'}" Command="{Binding RemoveModCommand}" InputGestureText="Del"
                                              ToolTip="{l:T 'Take a mod you have deleted off this list. Only entries that are no longer installed can be removed; untick an installed mod instead.'}" />
                                    <MenuItem Header="{l:T 'Remove all missing mods'}" Command="{Binding RemoveAllMissingCommand}" />
                                    <MenuItem Header="{l:T 'Subscribe to missing mods on the Workshop…'}" Command="{Binding SubscribeMissingCommand}" />
                                    <Separator />
                                    <MenuItem Header="{l:T 'Open folder'}" Command="{Binding OpenModFolderCommand}" />
                                    <MenuItem Header="{l:T 'Set download link…'}" Command="{Binding SetSourceLinkCommand}" />
                                    <MenuItem Header="{l:T 'Folders: server and client…'}" Command="{Binding EditModFoldersCommand}"
                                              Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}"
                                              ToolTip="{l:T 'Choose, folder by folder, whether the selected mod\&#x27;s folders are for the dedicated server, the game, or both (for example, keep RuntimeDataCache away from the server). The mod\&#x27;s own folder is not changed.'}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <!-- The band a row is in is why it can only be dragged so far, so say it on hover. -->
                                    <Setter Property="ToolTip" Value="{Binding BandName}" />
                                    <Style.Triggers>
                                        <!-- Coop in Host mode is a marker, not a mod you are choosing to run: it reads
                                             differently because dragging it changes the PLAYERS' game, not this server. -->
                                        <DataTrigger Binding="{Binding IsCoopClientMarker}" Value="True">
                                            <Setter Property="FontStyle" Value="Italic" />
                                            <Setter Property="ToolTip" Value="{Binding KindTip}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{l:T 'On'}" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- IsEnabled, not hidden: a greyed tick shows Native IS on and explains why it cannot be changed. -->
                                            <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanToggle}"
                                                      HorizontalAlignment="Center" Margin="0" ToolTip="{Binding KindTip}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{l:T 'Module'}" Binding="{Binding Id}" IsReadOnly="True" Width="200" />
                                <DataGridTextColumn Header="{l:T 'Kind'}" Binding="{Binding Kind}" IsReadOnly="True" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding KindTip}" />
                                            <!-- The game's own modules read as quieter than the mods you chose to install. -->
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGameModule}" Value="True">
                                                    <Setter Property="Opacity" Value="0.75" />
                                                    <Setter Property="FontStyle" Value="Italic" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{l:T 'Version'}" Binding="{Binding Version}" IsReadOnly="True" Width="90" />
                                <!-- The cell shows a plain-language label and stores a RoleChoice, which the row turns into the
                                     role and the Server-only logic tick the profile keeps. No ItemsSource here: a column is
                                     not in the visual tree, so it cannot bind to the view model, and the list changes with
                                     Experimental compatibility. The window sets it (ApplyRoleChoices). -->
                                <DataGridComboBoxColumn Header="{l:T 'Role'}" x:Name="RoleColumn" SelectedValueBinding="{Binding RoleChoice, UpdateSourceTrigger=PropertyChanged}"
                                                        DisplayMemberPath="Label" SelectedValuePath="Choice" Width="130">
                                    <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGameModule}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridComboBoxColumn.ElementStyle>
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGameModule}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>
                                <DataGridTemplateColumn Header="{l:T 'Server-only logic'}" x:Name="ServerOnlyColumn" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding ServerAuthoritative, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"
                                                      ToolTip="{l:T 'Run this mod\&#x27;s campaign/mission behaviours on the server only; players\&#x27; copies skip them and receive the results through Coop. Needs Settings sync (the shared module) on. Works best for behaviour-plus-settings mods; the Authority window lists what stays report-only.'}">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGameModule}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{l:T 'Behaviours'}" x:Name="BehavioursColumn" Binding="{Binding Behaviors}" IsReadOnly="True" Width="120" />
                                <DataGridTextColumn Header="{l:T 'Settings'}" Binding="{Binding Settings}" IsReadOnly="True" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding SettingsTip}" /></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{l:T 'Bins'}" x:Name="BinsColumn" Binding="{Binding Bins}" IsReadOnly="True" Width="100" />
                                <DataGridTemplateColumn Header="{l:T 'Compat'}" x:Name="CompatColumn" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CompatText}" ToolTip="{Binding CompatTip}" VerticalAlignment="Center" Margin="2,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedForeground}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CompatVerdictValue}" Value="{x:Static compat:CompatVerdict.Works}"><Setter Property="Foreground" Value="{DynamicResource SuccessForeground}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding CompatVerdictValue}" Value="{x:Static compat:CompatVerdict.NeedsRecipe}"><Setter Property="Foreground" Value="{DynamicResource WarningForeground}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding CompatVerdictValue}" Value="{x:Static compat:CompatVerdict.Broken}"><Setter Property="Foreground" Value="{DynamicResource DangerForeground}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{l:T 'Operation compatibility'}" x:Name="ServerVerdictColumn" Binding="{Binding OperationSummary}" IsReadOnly="True" Width="190">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{l:T 'Use Analyze operations for evidence. A recognized provider is not a runtime verification.'}" /></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{l:T 'Notes'}" x:Name="NotesColumn" Binding="{Binding Notes}" IsReadOnly="True" Width="150" />
                                <DataGridTextColumn Header="{l:T 'Source'}" Binding="{Binding Source}" IsReadOnly="True" Width="90" />
                                <DataGridTextColumn Header="{l:T 'Folder'}" Binding="{Binding Folder}" IsReadOnly="True" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2,0" />
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="LoadOrderRow" Height="260" MinHeight="80" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="80" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{l:T 'Engine load order'}" FontWeight="Bold" Margin="0,0,0,4" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding LoadOrderPreview}" />
                        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,2" />
                        <TextBlock Grid.Row="3" Text="{l:T 'Messages'}" FontWeight="Bold" Margin="0,4,0,4" />
                        <ListBox Grid.Row="4" ItemsSource="{Binding Messages}" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- SAVES -->
            <TabItem Header="{l:T 'Saves'}" DataContext="{Binding Host}" Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{l:T 'Save to host:'}" VerticalAlignment="Center" />
                        <TextBox Width="260" Margin="6,0" Text="{Binding Profile.SaveName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}" Text="{l:T 'Pick one below, or type a new name to start from default_new_game.sav — which is a vanilla world, with none of this profile\&#x27;s mods in it.'}" />
                    </StackPanel>
                    <!-- Seeding from the game: the server can only ever create a vanilla world, so a world containing
                         this profile's mods has to be started in Bannerlord itself and brought across. -->
                    <Expander DockPanel.Dock="Bottom" Header="{l:T 'Import a world from the game'}" Margin="0,6,0,0">
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}"
                                       Text="{l:T 'The server cannot build a world with mods in it. Start a campaign in Bannerlord with this profile\&#x27;s mods (Play), then import that save here to host it.'}" />
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="{l:T 'Refresh'}" Command="{Binding RefreshClientSavesCommand}" Padding="10,3" />
                                <Button Content="{l:T 'Import selected'}" Command="{Binding ImportClientSaveCommand}" Margin="6,0,0,0" Padding="10,3" />
                            </StackPanel>
                            <DataGrid Height="120" ItemsSource="{Binding ClientSaves}" SelectedItem="{Binding SelectedClientSave}" AutoGenerateColumns="False" IsReadOnly="True" RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:T 'Save'}" Binding="{Binding Name}" Width="200" />
                                    <DataGridTextColumn Header="{l:T 'Character'}" Binding="{Binding Character}" Width="120" />
                                    <DataGridTextColumn Header="{l:T 'Day'}" Binding="{Binding Day}" Width="60" />
                                    <DataGridTextColumn Header="{l:T 'Written'}" Binding="{Binding Written}" Width="130" />
                                    <DataGridTextColumn Header="{l:T 'Community modules in save'}" Binding="{Binding Mods}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Expander>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="80" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="SaveDiffRow" Height="110" MinHeight="60" />
                        </Grid.RowDefinitions>
                        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,2" />
                        <TextBox Grid.Row="2" Text="{Binding SaveDiff, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    <DataGrid Grid.Row="0" ItemsSource="{Binding Saves}" SelectedItem="{Binding SelectedSave}" AutoGenerateColumns="False" IsReadOnly="True" RowHeaderWidth="0">
                        <!-- A save's versions open under it with the + in the first column; the one chosen there is what Launch loads. -->
                        <!-- The toggle's binding names UpdateSourceTrigger on purpose: inside a DataGrid cell a binding is
                             otherwise held until the row commits an edit, which a read-only grid never does, so the click
                             checked the button and the row stayed shut. -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="DetailsVisibility" Value="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <DockPanel Margin="28,2,4,6">
                                    <!-- Row details are measured with unlimited width, so text only wraps with a width of its own. -->
                                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" MaxWidth="730" HorizontalAlignment="Left" Margin="0,0,0,4" Foreground="{DynamicResource MutedForeground}"
                                               Text="{l:T 'Click the version the next Launch should load. The top one, the save as it is now, is used unless you pick another. Choosing an older one changes nothing until you press Launch; then the save as it is now is backed up and the chosen version takes its place.'}" />
                                    <!-- SelectedItem names UpdateSourceTrigger: inside a DataGrid row a binding otherwise waits for the
                                         row to commit an edit, which a read-only grid never does. -->
                                    <DataGrid ItemsSource="{Binding Versions}" SelectedItem="{Binding ChosenVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              AutoGenerateColumns="False" IsReadOnly="True" RowHeaderWidth="0" HeadersVisibility="Column" SelectionMode="Single"
                                              MaxHeight="220" HorizontalAlignment="Left">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{l:T 'Version'}" Binding="{Binding Taken}" Width="330" />
                                            <DataGridTextColumn Header="{l:T 'Day'}" Binding="{Binding Day}" Width="70" />
                                            <DataGridTextColumn Header="{l:T 'Size'}" Binding="{Binding Size}" Width="90" />
                                            <DataGridTextColumn Header="{l:T 'Player file'}" Binding="{Binding Players}" Width="110" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="28" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton Width="20" Height="20" Padding="0" FontWeight="Bold" Content="{Binding ExpandGlyph}"
                                                      IsChecked="{Binding IsExpanded, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding VersionsTip}"
                                                      Visibility="{Binding HasVersions, Converter={StaticResource BoolToVis}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:T 'Save'}" Binding="{Binding Name}" Width="200" />
                            <DataGridTextColumn Header="{l:T 'Loads'}" Binding="{Binding Loads}" Width="170" />
                            <DataGridTextColumn Header="{l:T 'Character'}" Binding="{Binding Character}" Width="120" />
                            <DataGridTextColumn Header="{l:T 'Level'}" Binding="{Binding Level}" Width="50" />
                            <DataGridTextColumn Header="{l:T 'Day'}" Binding="{Binding Day}" Width="60" />
                            <DataGridTextColumn Header="{l:T 'Written'}" Binding="{Binding Written}" Width="130" />
                            <DataGridTextColumn Header="{l:T 'Community modules in save'}" Binding="{Binding Mods}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- SERVER -->
            <TabItem Header="{l:T 'Server'}" DataContext="{Binding Host}" Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="8" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="{l:T 'Written to server-config.json on every launch (a backup goes to config-backups).'}" Foreground="{DynamicResource MutedForeground}" Margin="0,0,0,10" />
                    <UniformGrid Columns="2" Rows="17">
                        <TextBlock Text="{l:T 'Join port (UDP, forward this)'}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Profile.Server.JoinPort}" />
                        <TextBlock Text="{l:T 'Password (empty = open)'}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Profile.Server.Password}" />
                        <TextBlock Text="{l:T 'Steam discoverability'}" VerticalAlignment="Center" />
                        <CheckBox IsChecked="{Binding Profile.Server.Steam}" HorizontalAlignment="Left" />
                        <TextBlock Text="{l:T 'Steam visibility'}" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding Visibilities}" SelectedItem="{Binding Profile.Server.Visibility}" />
                        <TextBlock Text="{l:T 'Autosave minutes (0 = off)'}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Profile.Server.AutosaveMinutes}" />
                        <TextBlock Text="{l:T 'Server guards (Compat module)'}" VerticalAlignment="Center" ToolTip="{l:T 'Loads the launcher\&#x27;s DedicatedServer.ModderLordsCompat module on the server: answers inquiries and swallows screen pushes so single-player mods do not crash the headless host. Server-only; players need nothing.'}" />
                        <CheckBox IsChecked="{Binding Profile.CompatGuards}" HorizontalAlignment="Left" />
                        <TextBlock Text="{l:T 'Settings sync (ModderLords.Compat)'}" VerticalAlignment="Center" ToolTip="{l:T 'Pushes the server\&#x27;s MCM settings to joining players. Adds the shared ModderLords.Compat module to the server AND to the player mod list: every player must install it (copy compat\\ModderLords.Compat from the launcher folder into their game Modules folder) and enable it.'}" />
                        <CheckBox IsChecked="{Binding Profile.SettingsSync}" HorizontalAlignment="Left" />
                        <!-- The one thing this launcher writes inside the DedicatedServer package, so it is opt-in and
                             says so. Turning it off restores SandBox's file on the next launch. -->
                        <TextBlock Text="{l:T 'Use a map mod\&#x27;s distance cache'}" VerticalAlignment="Center" ToolTip="{l:T 'A map mod replaces the campaign map but the server always reads SandBox\&#x27;s settlement distance cache, which was built for the vanilla map — the mismatch crashes world loading in a loop that never ends. This replaces that file with the one your map mod ships (TAOM_Map ships a rebuilt 10 MB cache). It is the only file the launcher writes inside the DedicatedServer folder; the original is backed up and put back when you untick this. Leave off unless you are running a map-replacing mod.'}" />
                        <CheckBox IsChecked="{Binding Profile.UseModDistanceCache}" HorizontalAlignment="Left" />
                        <!-- Creation only. An existing save is loaded untouched however this is set; see
                             Profile.GenerateWorldWithActiveMods and WorldCreationPolicy. -->
                        <TextBlock Text="{l:T 'Generate a new world with the active mods'}" VerticalAlignment="Center" ToolTip="{l:T 'When a NEW save has to be made, run the engine once with your mods loaded and generate the campaign from them, instead of copying the vanilla default_new_game.sav — which lists only Native, SandBoxCore, Sandbox and Coop, so a world bootstrapped from it never contains your mods. This never touches a save that already exists: if the save name points at a campaign on disk, that campaign is loaded and nothing is generated. Costs one extra engine run before the server starts (up to 15 minutes with heavy mods).'}" />
                        <CheckBox IsChecked="{Binding Profile.GenerateWorldWithActiveMods}" HorizontalAlignment="Left" />
                        <TextBlock Text="{l:T 'Warn if loading stalls (seconds)'}" VerticalAlignment="Center" ToolTip="{l:T 'How long the launch console waits with no loading progress before saying so. Empty uses the default (5 minutes); 0 turns the warning off. Heavy mods can legitimately load for a very long time — TAOM\&#x27;s authors quote up to two hours — so raise it or set 0 for those rather than being nagged.'}" />
                        <TextBox Text="{Binding Profile.StallWarningSeconds, TargetNullValue=''}" />
                        <TextBlock Text="{l:T 'Server log file'}" VerticalAlignment="Center" />
                        <CheckBox IsChecked="{Binding Profile.Server.LogFile}" HorizontalAlignment="Left" />
                        <TextBlock Text="{l:T 'Engine port / region'}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="70" Text="{Binding Profile.Server.EnginePort}" />
                            <ComboBox Width="70" Margin="6,0" ItemsSource="{Binding Regions}" SelectedItem="{Binding Profile.Server.Region}" />
                        </StackPanel>
                        <TextBlock Text="{l:T 'Trace tick / publish / bandits'}" VerticalAlignment="Center" Foreground="{DynamicResource WarningForeground}"
                                   ToolTip="{l:T 'Diagnostics only. The engine prints hundreds of thousands of lines a second with these on, which fills the launch log with gigabytes and slows the whole machine. Leave them off unless you are chasing a specific bug.'}" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding Profile.Server.TraceTick}" />
                            <CheckBox IsChecked="{Binding Profile.Server.TracePublish}" />
                            <CheckBox IsChecked="{Binding Profile.Server.TraceBandits}" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource WarningForeground}" TextWrapping="Wrap"
                               Text="{l:T 'Leave the Trace switches off for normal play. They make the engine print hundreds of thousands of lines a second: the launch log grows by gigabytes a minute and the machine slows down. They are for chasing a specific bug, then turning back off.'}" />
                    <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap"
                               Text="{l:T 'Gameplay settings (difficulty, fast forward, cheats) live in CoopData\\mod-config.json and are owned by the Coop mod; edit that file directly for now.'}" />
                    <!-- App-wide, not per profile. Off means off at launch too, not just hidden: ticks stay in the profile
                         but no gates, relays, rewrites, state sync or tracing are written into recipes.json. -->
                    <Expander Header="{l:T 'Advanced'}" Margin="0,16,0,0">
                        <StackPanel Margin="4,6,0,0">
                            <CheckBox Content="{l:T 'Experimental compatibility'}" IsChecked="{Binding Main.ExperimentalCompat}"
                                      ToolTip="{l:T 'Enables explicit legacy Server-only logic selections and diagnostic tracing. Generated rewrites, relays and state transformations remain inactive. Applies to the next launch.'}" />
                            <TextBlock Margin="20,6,0,0" Foreground="{DynamicResource WarningForeground}" TextWrapping="Wrap"
                                       Text="{l:T 'Experimental. It changes how a mod\&#x27;s own code runs, and works for some mods only. When off, Server-only logic ticks are kept but ignored at launch.'}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </TabItem>

            <!-- HOST: ModderLords' own server features. The toggles are the compat module's ModderLordsSettings, stored as
                 host overrides (LiveSettingsViewModel.OwnSettingsId) and sent live while the server runs. -->
            <TabItem Header="{l:T 'Host'}" DataContext="{Binding Host}" Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="{l:T 'Server upkeep'}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="{l:T 'Restart every N hours (0 = off)'}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding Profile.AutoRestartHours}"
                                     ToolTip="{l:T 'Once the server has been serving this long, the launcher stops it (the stop saves the campaign) and launches it again. The Console and every player\&#x27;s screen get a warning 10 minutes and 1 minute before.'}" />
                            <TextBlock Grid.Row="1" Text="{l:T 'Also export ModderLords.Compat to'}" VerticalAlignment="Center" Margin="0,4,0,0" />
                            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,4,0,0">
                                <Button DockPanel.Dock="Right" Content="{l:T 'Clear'}" Margin="4,0,0,0" Command="{Binding ClearCompatExportFolderCommand}" />
                                <Button DockPanel.Dock="Right" Content="{l:T 'Browse…'}" Margin="6,0,0,0" Command="{Binding BrowseCompatExportFolderCommand}" />
                                <TextBox IsReadOnly="True" Text="{Binding Profile.CompatExportFolder, Mode=OneWay}"
                                     ToolTip="{l:T 'A folder (e.g. a shared Dropbox or OneDrive folder) that also gets an up-to-date copy of the client ModderLords.Compat module, at startup and when launching. Friends copy it into their game\&#x27;s Modules folder. Empty = off.'}" />
                            </DockPanel>
                        </Grid>
                        <TextBlock Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" Margin="0,0,0,16"
                                   Text="{l:T 'Saved with the profile (Save, or Launch).'}" />

                        <TextBlock Text="{l:T 'Gameplay rules'}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                        <CheckBox Content="{l:T 'Freeze offline players\&#x27; gold and XP'}" IsChecked="{Binding LiveSettings.FreezeOfflinePlayers}" Margin="0,2"
                                  ToolTip="{l:T 'While a player is offline their hero gains and loses no gold and gains no skill XP: caravans, workshops and fiefs stop paying them and trading stops raising Trade. Edits from the Characters tab still apply.'}" />
                        <CheckBox Content="{l:T 'Protect player kingdoms from AI wars'}" IsChecked="{Binding LiveSettings.ProtectPlayerKingdoms}" Margin="0,2"
                                  ToolTip="{l:T 'AI kingdoms never pick a kingdom a player belongs to as a war target, and any war that still starts against one is ended with peace on the next tick. Wars a player\&#x27;s kingdom declares, and wars caused by a player\&#x27;s own hostility or crime, are allowed.'}" />
                        <CheckBox Content="{l:T 'Also protect them from rebellions'}" IsChecked="{Binding LiveSettings.ProtectFromRebellions}" Margin="20,2,0,2"
                                  IsEnabled="{Binding LiveSettings.ProtectPlayerKingdoms}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{l:T 'Apply'}" Command="{Binding LiveSettings.ApplyHostOptionsCommand}" FontWeight="Bold" />
                            <TextBlock Text="{Binding LiveSettings.HostOptionsReport}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SuccessForeground}" />
                        </StackPanel>
                        <TextBlock Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{l:T 'These run on the server and need Settings sync (Server tab). Apply sends them to a running server at once and keeps them for every launch of this profile.'}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- GAMEPLAY (mod-config.json) -->
            <TabItem Header="{l:T 'Gameplay'}" DataContext="{Binding Host}" Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="{l:T 'Reload'}" Command="{Binding LoadGameplayCommand}" />
                        <Button Content="{l:T 'Save to mod-config.json'}" Command="{Binding SaveGameplayCommand}" />
                        <TextBlock VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap"
                                   Text="{l:T 'CoopData\\mod-config.json, owned by the Coop mod. Values are replaced in place so its comments stay; a backup goes to config-backups. Applies on the next server start.'}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Gameplay}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T 'Section'}" Binding="{Binding Section}" IsReadOnly="True" Width="100" />
                            <DataGridTextColumn Header="{l:T 'Setting'}" Binding="{Binding Key}" IsReadOnly="True" Width="300" />
                            <DataGridTemplateColumn Header="{l:T 'Value'}" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding HasChoices, Converter={StaticResource BoolToVis}}" />
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding HasChoices, Converter={StaticResource InverseBoolToVis}}" BorderThickness="0" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:T 'Was'}" Binding="{Binding Original}" IsReadOnly="True" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- MOD SETTINGS (live MCM edits on the running server) -->
            <TabItem Header="{l:T 'Mod settings'}" DataContext="{Binding Host}" Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                     IsEnabled="{Binding LiveSettings.IsEnabled}" ToolTip="{Binding LiveSettings.GateHint}" ToolTipService.ShowOnDisabled="True">
                <DockPanel DataContext="{Binding LiveSettings}">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="{l:T 'Apply'}" Command="{Binding ApplyCommand}" FontWeight="Bold" ToolTip="{l:T 'Send the changed values to the running server; players get them on the next sync tick'}" />
                        <Button Content="{l:T 'Revert'}" Command="{Binding RevertCommand}" ToolTip="{l:T 'Discard unsent edits in this settings object'}" />
                        <Button Content="{l:T 'Reload'}" Command="{Binding ReloadCommand}" ToolTip="{l:T 'Re-read what the server last reported'}" />
                        <Button Content="{l:T 'Clear overrides'}" Command="{Binding ClearOverridesCommand}" ToolTip="{l:T 'Forget the stored host overrides for the selected settings object (they are re-applied at every launch until cleared)'}" />
                        <Border VerticalAlignment="Center" Margin="12,0,0,0" Padding="8,2" CornerRadius="9" Background="{DynamicResource BadgeBackground}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLive}" Value="True"><Setter Property="Background" Value="{DynamicResource SuccessBackground}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ModeText}" FontWeight="Bold" FontSize="11" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" Margin="8,0" Text="{Binding StatusText}" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" MaxWidth="700" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ApplyReport}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SuccessForeground}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SettingsObjectsColumn" Width="260" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="280" />
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Column="0" ItemsSource="{Binding Objects}" SelectedItem="{Binding SelectedObject}" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource MutedForeground}" FontSize="11" TextWrapping="Wrap" />
                                        <TextBlock Foreground="{DynamicResource WarningForeground}" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding OverrideCount, StringFormat='{}{0} override(s)'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OverrideCount}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2,0" />
                        <ScrollViewer Grid.Column="2" Margin="8,0,0,0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedObject.Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,4,0,4" />
                                            <ItemsControl ItemsSource="{Binding Properties}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1" ToolTip="{Binding ToolTip}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="300" />
                                                                <ColumnDefinition Width="240" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsDirty}" Value="True"><Setter Property="FontWeight" Value="Bold" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SubtleForeground}" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Grid Grid.Column="1">
                                                                <CheckBox IsChecked="{Binding BoolValue, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left" />
                                                                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsEnum, Converter={StaticResource BoolToVis}}" />
                                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                                                                <TextBlock Text="{Binding Value}" Foreground="{DynamicResource SubtleForeground}" VerticalAlignment="Center" Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}" TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <Border Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="0,0,8,0"
                                                                        Visibility="{Binding HasOverride, Converter={StaticResource BoolToVis}}" ToolTip="{Binding OverrideTip}">
                                                                    <TextBlock Text="{l:T 'override'}" FontSize="10" />
                                                                </Border>
                                                                <TextBlock Text="{Binding RangeText}" Foreground="{DynamicResource MutedForeground}" FontSize="11" />
                                                                <TextBlock Text="{Binding KindText}" Foreground="{DynamicResource SubtleForeground}" FontSize="11" Margin="8,0,0,0" Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}" />
                                                                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerForeground}" FontSize="11" Margin="8,0,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- CONSOLE -->
            <TabItem Header="{l:T 'Console'}" DataContext="{Binding Host}" Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <CheckBox Content="{l:T 'Engine'}" IsChecked="{Binding ShowEngine}" />
                        <CheckBox Content="{l:T 'Module load'}" IsChecked="{Binding ShowModuleLoad}" />
                        <CheckBox Content="{l:T 'Server'}" IsChecked="{Binding ShowServer}" />
                        <CheckBox Content="{l:T 'Coop'}" IsChecked="{Binding ShowCoop}" />
                        <CheckBox Content="{l:T 'Warnings'}" IsChecked="{Binding ShowWarnings}" />
                        <CheckBox Content="{l:T 'DLL probes'}" IsChecked="{Binding ShowProbes}" ToolTip="{l:T 'The engine tries every referenced DLL by bare name first and logs a miss before resolving it properly. Harmless.'}" />
                        <CheckBox Content="{l:T 'Console input + replies'}" IsChecked="{Binding ShowConsoleIo}"
                                  ToolTip="{l:T 'Show the commands you type and whatever the server prints just after them. Stays visible even with &quot;Errors + milestones only&quot; ticked.'}" />
                        <CheckBox Content="{l:T 'Errors + milestones only'}" IsChecked="{Binding ErrorsOnly}" />
                        <CheckBox Content="{l:T 'ModderLords only'}" IsChecked="{Binding OurMessagesOnly}"
                                  ToolTip="{l:T 'Show only the launcher\&#x27;s own lines and hide the engine\&#x27;s. A launch prints tens of thousands of engine lines, and the few that tell you what to do — which mod to change, why a world will be missing something — are all ours. Combine with Copy shown to get the whole story on the clipboard.'}" />
                        <CheckBox Content="{l:T 'Auto-scroll'}" IsChecked="{Binding AutoScroll}"
                                  ToolTip="{l:T 'Follow the newest output. Ticking it jumps to the bottom now; untick it to stop and read.'}" />
                        <TextBlock Text="{l:T 'Find:'}" VerticalAlignment="Center" Margin="12,0,4,0" />
                        <TextBox Width="220" Text="{Binding ConsoleFilter, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="{l:T 'Copy shown'}" Command="{Binding CopyShownCommand}" Margin="8,0,4,0"
                                ToolTip="{l:T 'Copy every line the console is currently showing. Select rows and press Ctrl+C (or right-click) to copy just those instead.'}" />
                        <Button Content="{l:T 'Logs folder'}" Command="{Binding OpenLogsFolderCommand}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:T 'Send'}" Command="{Binding SendCommandCommand}" />
                            <TextBox Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" KeyDown="Command_KeyDown"
                                     IsEnabled="{Binding IsRunning}" FontFamily="Consolas" />
                        </DockPanel>
                        <DockPanel Margin="2,3,0,0">
                            <!-- Says when the filters are hiding what is arriving. A console filtered down to nothing
                                 looks exactly like a console that has stopped; this is what tells them apart. -->
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ConsoleCounts}" Foreground="{DynamicResource MutedForeground}" Margin="12,0,0,0" />
                            <TextBlock Text="{Binding CommandStatus}" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>
                    <!-- Extended selection + Ctrl+C: the console was read-only, so the only way to report a line was a
                         screenshot of it. Virtualization stays on; SelectedItems is unaffected by recycling. -->
                    <ListBox x:Name="ConsoleList" ItemsSource="{Binding ConsoleView}" FontFamily="Consolas" FontSize="12"
                             SelectionMode="Extended" KeyDown="ConsoleList_KeyDown"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.VerticalScrollBarVisibility="Visible">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{l:T 'Copy selected lines'}" Click="ConsoleCopySelected_Click" InputGestureText="Ctrl+C" />
                                <MenuItem Header="{l:T 'Copy all shown lines'}" Command="{Binding CopyShownCommand}" />
                                <Separator />
                                <MenuItem Header="{l:T 'Select all'}" Click="ConsoleSelectAll_Click" InputGestureText="Ctrl+A" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Time}" Foreground="{DynamicResource LogTimestamp}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Category}" Width="80" Foreground="{DynamicResource MutedForeground}" />
                                    <TextBlock Text="{Binding Text}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static logs:LogCategory.Error}"><Setter Property="Foreground" Value="{DynamicResource LogError}" /><Setter Property="FontWeight" Value="Bold" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static logs:LogCategory.Warning}"><Setter Property="Foreground" Value="{DynamicResource LogWarning}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static logs:LogCategory.Milestone}"><Setter Property="Foreground" Value="{DynamicResource LogMilestone}" /><Setter Property="FontWeight" Value="Bold" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static logs:LogCategory.Tool}"><Setter Property="Foreground" Value="{DynamicResource LogTool}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static logs:LogCategory.Command}"><Setter Property="Foreground" Value="{DynamicResource LogCommand}" /><Setter Property="FontWeight" Value="Bold" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static logs:LogCategory.CommandReply}"><Setter Property="Foreground" Value="{DynamicResource LogCommandReply}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static logs:LogCategory.Probe}"><Setter Property="Foreground" Value="{DynamicResource LogProbe}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static logs:LogCategory.Engine}"><Setter Property="Foreground" Value="{DynamicResource LogEngine}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static logs:LogCategory.ModuleLoad}"><Setter Property="Foreground" Value="{DynamicResource LogModuleLoad}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static logs:LogCategory.Coop}"><Setter Property="Foreground" Value="{DynamicResource LogCoop}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- CHARACTERS: everything the host can change about the running world's people and places, one sub tab
                 each. Players: the list, the editor, export/import, kick and the ban list (bans are a file the server
                 rereads, so they work while it is stopped too). Companions: the same editor for the other heroes of
                 the players' clans. Holdings: who owns each town and castle. -->
            <TabItem Header="{l:T 'Characters'}" DataContext="{Binding Host}" Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Left" Content="{l:T 'Refresh'}" Command="{Binding Characters.RefreshCommand}" Padding="10,4" Margin="0,0,10,0"
                                ToolTip="{l:T 'Read the players, companions and holdings from the running server again'}" />
                        <TextBlock Text="{Binding Characters.Headline}" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <TabControl>
                    <TabItem Header="{l:T 'Players'}">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" Margin="0,0,0,8"
                               Text="{l:T 'Everyone with a character on the running server. Edit changes a character’s name, age, level, gold, attributes, skills, focus and traits on the server, and can reset their perks. Export saves a character to a file; Import brings one onto a player, cleaned of anything this world does not have. Kick disconnects a player; their character stays and they can rejoin. Ban disconnects them and refuses them from then on, by Steam id and by the address they connected from. The list updates when someone joins or leaves.'}" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{l:T 'Edit…'}" Command="{Binding Characters.EditCommand}" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="{l:T 'Export…'}" Command="{Binding Characters.ExportCommand}" Padding="10,4" Margin="0,0,8,0"
                                ToolTip="{l:T 'Save this character to a file: attributes, skills, perks, traits, gold, look and gear'}" />
                        <Button Content="{l:T 'Import…'}" Command="{Binding Characters.ImportCommand}" Padding="10,4" Margin="0,0,8,0"
                                ToolTip="{l:T 'Bring a saved character onto this player. You see what this world cannot hold before anything changes.'}" />
                        <Button Content="{l:T 'Kick'}" Command="{Binding Characters.KickCommand}" Padding="10,4" Margin="0,0,16,0" />
                        <TextBlock Text="{l:T 'Reason (optional):'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Characters.BanReason, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,8,0" />
                        <Button Content="{l:T 'Ban…'}" Command="{Binding Characters.BanCommand}" Padding="10,4" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Characters.ListStatus}" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" MinHeight="80" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="80" />
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0" ItemsSource="{Binding Characters.Players}" SelectedItem="{Binding Characters.SelectedPlayer}" AutoGenerateColumns="False" IsReadOnly="True" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T 'Character'}" Binding="{Binding Name}" Width="160" />
                                <DataGridTextColumn Header="{l:T 'Clan'}" Binding="{Binding Clan}" Width="140" />
                                <DataGridTextColumn Header="{l:T 'Level'}" Binding="{Binding Level}" Width="50" />
                                <DataGridTextColumn Header="{l:T 'Gold'}" Binding="{Binding Gold, StringFormat=N0}" Width="80" />
                                <DataGridTextColumn Header="{l:T 'State'}" Binding="{Binding State}" Width="140" />
                                <DataGridTextColumn Header="{l:T 'Steam id'}" Binding="{Binding SteamId}" Width="150" />
                                <DataGridTextColumn Header="{l:T 'Address'}" Binding="{Binding Ip}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Grid.Row="1" Margin="0,10,0,4">
                            <Button DockPanel.Dock="Right" Content="{l:T 'Unban'}" Command="{Binding Characters.UnbanCommand}" Padding="10,3" />
                            <TextBlock Text="{l:T 'Banned'}" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Characters.Bans}" SelectedItem="{Binding Characters.SelectedBan}" AutoGenerateColumns="False" IsReadOnly="True" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T 'Name'}" Binding="{Binding Name}" Width="160" />
                                <DataGridTextColumn Header="{l:T 'Steam id'}" Binding="{Binding SteamId}" Width="150" />
                                <DataGridTextColumn Header="{l:T 'Address'}" Binding="{Binding Ip}" Width="120" />
                                <DataGridTextColumn Header="{l:T 'Since'}" Binding="{Binding At, StringFormat=yyyy-MM-dd HH:mm}" Width="120" />
                                <DataGridTextColumn Header="{l:T 'Reason'}" Binding="{Binding Reason}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
                    </TabItem>
                    <TabItem Header="{l:T 'Companions'}">
                        <DockPanel Margin="8">
                            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" Margin="0,0,0,8"
                                       Text="{l:T 'The other heroes of the players’ clans: companions and family. Edit opens the same editor as for a player: name, gold, attributes, skills, focus, traits and a perk reset. Edits are refused while the party they travel with is in a battle or a siege.'}" />
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="{l:T 'Edit…'}" Command="{Binding Characters.EditCompanionCommand}" Padding="10,4" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Characters.CompanionStatus}" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <DataGrid ItemsSource="{Binding Characters.Companions}" SelectedItem="{Binding Characters.SelectedCompanion}" AutoGenerateColumns="False" IsReadOnly="True" RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:T 'Character'}" Binding="{Binding Name}" Width="200" />
                                    <DataGridTextColumn Header="{l:T 'Kind'}" Binding="{Binding Kind}" Width="90" />
                                    <DataGridTextColumn Header="{l:T 'Player'}" Binding="{Binding Owner}" Width="160" />
                                    <DataGridTextColumn Header="{l:T 'Clan'}" Binding="{Binding Clan}" Width="140" />
                                    <DataGridTextColumn Header="{l:T 'Level'}" Binding="{Binding Level}" Width="50" />
                                    <DataGridTextColumn Header="{l:T 'Age'}" Binding="{Binding Age}" Width="50" />
                                    <DataGridTextColumn Header="{l:T 'Where'}" Binding="{Binding Where}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="{l:T 'Holdings'}">
                        <DockPanel Margin="8">
                            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" Margin="0,0,0,8"
                                       Text="{l:T 'Who owns each town and castle. Pick one, pick the clan that should have it, then Give. Villages go with the town or castle they belong to, and the settlement joins the new owner’s kingdom. The change is the game’s own, the one a granted fief goes through, and reaches every player through Coop. It is refused while the settlement is under siege or in a battle. This list is read when the server starts and when you press Refresh.'}" />
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{l:T 'New owner:'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding Characters.Clans}" SelectedItem="{Binding Characters.NewOwner}" DisplayMemberPath="Display" Width="320" Margin="0,0,8,0" />
                                <Button Content="{l:T 'Give…'}" Command="{Binding Characters.SetOwnerCommand}" Padding="10,4" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Characters.HoldingStatus}" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <DataGrid ItemsSource="{Binding Characters.Holdings}" SelectedItem="{Binding Characters.SelectedHolding}" AutoGenerateColumns="False" IsReadOnly="True" RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:T 'Settlement'}" Binding="{Binding Name}" Width="200" />
                                    <DataGridTextColumn Header="{l:T 'Type'}" Binding="{Binding Type}" Width="70" />
                                    <DataGridTextColumn Header="{l:T 'Owner'}" Binding="{Binding Clan}" Width="180" />
                                    <DataGridTextColumn Header="{l:T 'Kingdom'}" Binding="{Binding Kingdom}" Width="180" />
                                    <DataGridTextColumn Header="{l:T 'Villages'}" Binding="{Binding Villages}" Width="70" />
                                    <DataGridTextColumn Header="{l:T 'State'}" Binding="{Binding State}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    </TabControl>
                </DockPanel>
            </TabItem>

            <!-- SHARE: hand your mod list to somebody, or take theirs. That half is the whole point of a mod
                 loader, so it is in both modes; the right-hand column compares this PC's launcher with the server
                 you are hosting, so that half is Host mode only. -->
            <TabItem Header="{l:T 'Smoke test'}" DataContext="{Binding Host}" Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" Margin="0,0,0,8"
                               Text="{l:T 'Starts the server if it is not running, then starts Bannerlord on this PC so that it joins by itself. The test waits for the campaign map, runs campaign time there for the seconds below, then closes the game and checks both sides: the join, the world transfer, the server\&#x27;s view of the player, a ping over ModderLords\&#x27; own channel, that time passed, crashes, and ModderLords warnings. If the world has no character for you yet, one is created at random (named &quot;Smoke&quot; and a number) and stays in the world. Don\&#x27;t use the PC while it runs: the game window comes to the front.'}" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{l:T 'Seconds on the map:'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Smoke.SteadySeconds, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,16,0" />
                        <CheckBox Content="{l:T 'Run campaign time'}" IsChecked="{Binding Smoke.RunCampaignTime}" VerticalAlignment="Center" Margin="0,0,16,0"
                                  ToolTip="{l:T 'Fast-forwards the campaign while the game is on the map, so daily ticks, AI and mods run. The world\&#x27;s date moves on.'}" />
                        <CheckBox Content="{l:T 'Close the game when done'}" IsChecked="{Binding Smoke.CloseGameWhenDone}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <CheckBox Content="{l:T 'Stop the server afterwards if the test started it'}" IsChecked="{Binding Smoke.StopServerIfStartedHere}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{l:T 'Run smoke test'}" Command="{Binding Smoke.RunCommand}" Padding="14,4" Margin="0,0,8,0" />
                        <Button Content="{l:T 'Cancel'}" Command="{Binding Smoke.CancelCommand}" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="{l:T 'Open report folder'}" Command="{Binding Smoke.OpenReportCommand}" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="{l:T 'Copy report'}" Command="{Binding Smoke.CopyReportCommand}" Padding="10,4" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Smoke.Headline}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Smoke.Checks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="0,0,0,1" Padding="4,4">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Verdict}" Width="48" FontFamily="Consolas" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedForeground}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Verdict}" Value="OK"><Setter Property="Foreground" Value="{DynamicResource SuccessForeground}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Verdict}" Value="WARN"><Setter Property="Foreground" Value="{DynamicResource WarningForeground}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Verdict}" Value="FAIL"><Setter Property="Foreground" Value="{DynamicResource DangerForeground}" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel>
                                                    <TextBlock TextWrapping="Wrap"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" /><Run Text=": " /><Run Text="{Binding Detail, Mode=OneWay}" /></TextBlock>
                                                    <TextBlock Text="{Binding Evidence}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}"
                                                               Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="{DynamicResource SplitterBrush}" />
                        <ListBox Grid.Row="2" ItemsSource="{Binding Smoke.Progress}" FontFamily="Consolas" FontSize="11" />
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="{l:T 'Share'}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{Binding IsHost, Converter={StaticResource HostColumnWidth}}" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="0,0,6,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{l:T 'Mod list'}" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Content="{l:T 'Copy'}" Command="{Binding CopyManifestCommand}" />
                <Button Content="{l:T 'Export…'}" Command="{Binding ExportListCommand}"
                        ToolTip="{l:T 'Save this mod list, versions and load order to a file you can send to a player or another host'}" />
                <Button Content="{l:T 'Import…'}" Command="{Binding ImportListCommand}"
                        ToolTip="{l:T 'Read a mod list somebody shared: set up this PC\&#x27;s Bannerlord launcher to match, and/or create a server profile from it'}" />
                        </StackPanel>
                        <TextBox Text="{Binding ClientManifestText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </DockPanel>
                    <DockPanel Grid.Column="1" Margin="6,0,0,0" DataContext="{Binding Host}"
                               Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{l:T 'This PC\&#x27;s Bannerlord launcher vs the server'}" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Content="{l:T 'Check my client'}" Command="{Binding CheckMyClientCommand}" />
                <Button Content="{l:T 'Match server…'}" Command="{Binding MatchServerCommand}"
                        ToolTip="{l:T 'Show what Launch client would change in this PC\&#x27;s Bannerlord launcher mod list, and optionally apply it now'}" />
                        </StackPanel>
                        <TextBox Text="{Binding ClientCheckText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- PERFORMANCE -->
            <TabItem Header="{l:T 'Performance'}" DataContext="{Binding Host}" Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Performance.SessionState}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" Margin="0,0,0,8"
                               Text="{l:T 'Measured against what YOUR server normally does this session, not against fixed numbers — the first minute after launch is ignored as world load. Samples arrive every 10 seconds.'}" />

                    <Border DockPanel.Dock="Top" Padding="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:T 'Campaign time: '}" Foreground="{DynamicResource MutedForeground}" />
                            <TextBlock Text="{Binding Performance.CampaignMode}" Margin="0,0,20,0" />
                            <TextBlock Text="{l:T 'Players: '}" Foreground="{DynamicResource MutedForeground}" />
                            <TextBlock Text="{Binding Performance.Players}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Performance.PlayersNote}" Foreground="{DynamicResource MutedForeground}" FontStyle="Italic" Margin="0,0,20,0" />
                            <TextBlock Text="{l:T 'Data this session: '}" Foreground="{DynamicResource MutedForeground}" />
                            <TextBlock Text="{Binding Performance.DataTotals}" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Performance.Metrics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,8">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Value}" HorizontalAlignment="Right" DockPanel.Dock="Right" FontFamily="Consolas" FontSize="15" />
                                            </DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,2">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Departed}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBorder}" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Explanation}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedForeground}" FontSize="11" Margin="0,4,0,0" />
                                            <controls:Sparkline Values="{Binding History}" BandLow="{Binding BandLow}"
                                                                BandHigh="{Binding BandHigh}" HasBand="{Binding HasBand}" Height="52" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
