<Window x:Class="ModderLords.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ModderLords.App.ViewModels"
        xmlns:logs="clr-namespace:ModderLords.Core.Logs;assembly=ModderLords.Core"
        xmlns:compat="clr-namespace:ModderLords.Core.Compat;assembly=ModderLords.Core"
        xmlns:controls="clr-namespace:ModderLords.App.Controls"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Foreground}"
        Title="ModderLords" Height="820" Width="1280" MinWidth="960" MinHeight="600"
        Icon="pack://application:,,,/ModderLords;component/appicon.ico"
        Closing="Window_Closing">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vm:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <vm:HostColumnWidthConverter x:Key="HostColumnWidth" />
    </Window.Resources>

    <DockPanel>
        <!-- top bar: profile + launch -->
        <Border DockPanel.Dock="Top" Padding="8" Background="{DynamicResource ChromeBackground}">
            <DockPanel>
                <TextBlock Text="Profile" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="160" ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfileName}" DropDownOpened="Profiles_DropDownOpened" />
                <Button Content="New" Command="{Binding NewProfileCommand}" />
                <Button Content="Save" Command="{Binding SaveProfileCommand}" />
                <Button Content="Delete" Command="{Binding DeleteProfileCommand}" />
                <Button Content="Rescan mods" Command="{Binding RescanCommand}" />
                <Button Content="Re-sync junctions" Command="{Binding Host.ResyncCommand}" Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}"
                        ToolTip="Recreate the links under engine\Modules (after a workshop update or a Steam re-download of the server)" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <!-- One click, no restart. Which half of the app you get is the first thing you chose and the
                         easiest thing to change; see FirstRunWindow. -->
                    <Button x:Name="ModeButton" Content="Player mode" Click="Mode_Click" MinWidth="92" Margin="4,0,4,0" />
                    <Button x:Name="ThemeButton" Content="Dark" Click="Theme_Click" MinWidth="52" Margin="4,0,12,0"
                            ToolTip="Switch between the light and dark theme" />
                    <!-- Player mode launches the mods you picked; Host mode launches the game that joins the server
                         you are running, which is why the wording and the tooltip change with the mode. -->
                    <Button Command="{Binding LaunchClientCommand}" Margin="4,0,20,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="Play" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Background" Value="{DynamicResource SuccessBackground}" />
                                <Setter Property="ToolTip" Value="Start Bannerlord with exactly the mods this profile enables, in this order. Your TaleWorlds launcher mod list is not touched." />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHost}" Value="True">
                                        <Setter Property="Content" Value="Launch client" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
                                        <Setter Property="ToolTip" Value="Start Bannerlord from the game folder, with its mod list matched to the server. Steam's Play button is blocked while the coop server is running, because the Coop mod logs the server on to Steam as a game server; starting the exe here is not blocked." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Launch server" Command="{Binding Host.LaunchCommand}" FontWeight="Bold" Background="{DynamicResource SuccessBackground}"
                            Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Stop" Command="{Binding Host.StopCommand}" Background="{DynamicResource DangerBackground}"
                            Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="16,0" FontStyle="Italic" />
            </DockPanel>
        </Border>

        <!-- drift banner -->
        <Border DockPanel.Dock="Top" Padding="8,6" Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Host.DriftText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        <!-- Player mode has no Host, so the binding is null rather than empty and matches neither
                             the trigger above nor anything else: say so explicitly. -->
                        <DataTrigger Binding="{Binding Host.DriftText}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Host.DriftText}" TextWrapping="Wrap" />
        </Border>

        <!-- status bar -->
        <Border DockPanel.Dock="Bottom" Padding="8,4" Background="{DynamicResource ChromeBackground}">
            <DockPanel>
                <!-- Support link. The mark keeps its brand colours in both themes, so it sits on its own
                     light chip rather than vanishing into a dark background. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Background="{StaticResource BmcChip}" CornerRadius="4" Padding="4,3" VerticalAlignment="Center">
                        <Viewbox Width="15" Height="21">
                            <Canvas Width="27" Height="39">
                                <Path Data="{StaticResource BmcCupGeometry}" Fill="{StaticResource BmcYellow}" />
                                <Path Data="{StaticResource BmcOutlineGeometry}" Fill="{StaticResource BmcDark}" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock VerticalAlignment="Center" Margin="6,0,0,0">
                        <Hyperlink NavigateUri="https://buymeacoffee.com/ryvius" RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{DynamicResource LogTool}"
                                   ToolTip="Opens buymeacoffee.com/ryvius in your browser">Buy me a coffee</Hyperlink>
                    </TextBlock>
                </StackPanel>
                <StackPanel>
                    <TextBlock Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}"><Run Text="Server: " FontWeight="Bold" /><Run Text="{Binding ServerRoot}" /></TextBlock>
                    <TextBlock><Run Text="Game:   " FontWeight="Bold" /><Run Text="{Binding GameRoot}" /></TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="8" SelectionChanged="Tabs_SelectionChanged">
            <!-- MODS -->
            <TabItem Header="Mods">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="360" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="ModsSidebarColumn" Width="300" MinWidth="220" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Move up" Command="{Binding MoveUpCommand}" />
                            <Button Content="Move down" Command="{Binding MoveDownCommand}" />
                            <Button Content="Refresh order" Command="{Binding RefreshPreviewCommand}" />
                            <Button Content="Use engine order" Command="{Binding UseEngineOrderCommand}"
                                    ToolTip="Sort this list into the order the engine actually loads (shown on the right). Only mods that a manifest forces to move are moved; the rest keep the place you gave them." />
                            <!-- The computed order is assembled from module metadata, and metadata is sometimes wrong
                                 (TAOM_Map declares that TAOM loads before it, contradicting its own authors' published
                                 order). No dependency logic covers every case, so the user has to be able to win. -->
                            <CheckBox Content="My order wins" IsChecked="{Binding ManualLoadOrder}" VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="Use this list exactly as written, even where a mod's manifest declares a different order. Conflicts are still listed under the order preview, so you can see what you are overriding. Leave off unless a mod's declared order is wrong." />
                            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource MutedForeground}"
                                       ToolTip="Frameworks declare that the game's own modules load after them, so they sit above the game and cannot be moved below it. The game's own modules are placed by the engine."
                                       Text="Drag to reorder within Frameworks / Game / Mods" />
                            <Button Content="Behaviours…" Command="{Binding EditBehaviorsCommand}" ToolTip="Choose which of the selected mod's behaviours run on the server only"
                                    Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Record…" Command="{Binding RecordCompatCommand}" Margin="12,0,0,0" ToolTip="Record how the selected mod behaves under Coop (verdict, notes, defaults). Saved to your local compat database."
                                    Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Export…" Command="{Binding ExportCompatCommand}" ToolTip="Write the selected mod's record (or all your local records) to a file you can share"
                                    Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Import…" Command="{Binding ImportCompatCommand}" ToolTip="Merge a shared record file into your local compat database (newer records win)"
                                    Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" />
                            <TextBlock VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource MutedForeground}"
                                       Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}"
                                       Text="Run = load its code on the server. DependencyOnly = listed for the handshake, no code (UI frameworks). AsShipped = let the engine decide." />
                        </StackPanel>
                        <!-- CanUserSortColumns is OFF and must stay off. This list IS the load order: the row order
                             is the thing being edited, and a column sort silently decouples what you see from the
                             collection underneath, so Move up/down and dragging act on rows other than the ones you
                             are looking at. That is exactly what it did before this was set. -->
                        <DataGrid x:Name="ModsGrid" ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserSortColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                                  PreviewMouseLeftButtonDown="ModsGrid_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="ModsGrid_PreviewMouseMove" Drop="ModsGrid_Drop" DragOver="ModsGrid_DragOver"
                                  DragLeave="ModsGrid_DragLeave"
                                  AllowDrop="True">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <!-- The band a row is in is why it can only be dragged so far, so say it on hover. -->
                                    <Setter Property="ToolTip" Value="{Binding BandName}" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="On" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- IsEnabled, not hidden: a greyed tick shows Native IS on and explains why it cannot be changed. -->
                                            <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanToggle}"
                                                      HorizontalAlignment="Center" Margin="0" ToolTip="{Binding KindTip}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Module" Binding="{Binding Id}" IsReadOnly="True" Width="200" />
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" IsReadOnly="True" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding KindTip}" />
                                            <!-- The game's own modules read as quieter than the mods you chose to install. -->
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGameModule}" Value="True">
                                                    <Setter Property="Opacity" Value="0.75" />
                                                    <Setter Property="FontStyle" Value="Italic" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" IsReadOnly="True" Width="90" />
                                <DataGridComboBoxColumn Header="Role" x:Name="RoleColumn" SelectedItemBinding="{Binding Role, UpdateSourceTrigger=PropertyChanged}"
                                                        ItemsSource="{x:Static vm:ModRow.Roles}" Width="130">
                                    <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGameModule}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridComboBoxColumn.ElementStyle>
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGameModule}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>
                                <DataGridTemplateColumn Header="Server-only logic" x:Name="ServerOnlyColumn" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding ServerAuthoritative, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"
                                                      ToolTip="Run this mod's campaign/mission behaviours on the server only; players' copies skip them and receive the results through Coop. Needs Settings sync (the shared module) on.">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGameModule}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Behaviours" x:Name="BehavioursColumn" Binding="{Binding Behaviors}" IsReadOnly="True" Width="120" />
                                <DataGridTextColumn Header="Settings" Binding="{Binding Settings}" IsReadOnly="True" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding SettingsTip}" /></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Bins" x:Name="BinsColumn" Binding="{Binding Bins}" IsReadOnly="True" Width="100" />
                                <DataGridTemplateColumn Header="Compat" x:Name="CompatColumn" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CompatText}" ToolTip="{Binding CompatTip}" VerticalAlignment="Center" Margin="2,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedForeground}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CompatVerdictValue}" Value="{x:Static compat:CompatVerdict.Works}"><Setter Property="Foreground" Value="{DynamicResource SuccessForeground}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding CompatVerdictValue}" Value="{x:Static compat:CompatVerdict.NeedsRecipe}"><Setter Property="Foreground" Value="{DynamicResource WarningForeground}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding CompatVerdictValue}" Value="{x:Static compat:CompatVerdict.Broken}"><Setter Property="Foreground" Value="{DynamicResource DangerForeground}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Server verdict" x:Name="ServerVerdictColumn" Binding="{Binding ServerVerdict}" IsReadOnly="True" Width="190">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding ServerVerdictDetail}" /></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Notes" x:Name="NotesColumn" Binding="{Binding Notes}" IsReadOnly="True" Width="150" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" IsReadOnly="True" Width="90" />
                                <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" IsReadOnly="True" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2,0" />
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="LoadOrderRow" Height="260" MinHeight="80" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="80" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Engine load order" FontWeight="Bold" Margin="0,0,0,4" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding LoadOrderPreview}" />
                        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,2" />
                        <TextBlock Grid.Row="3" Text="Messages" FontWeight="Bold" Margin="0,4,0,4" />
                        <ListBox Grid.Row="4" ItemsSource="{Binding Messages}" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- SAVES -->
            <TabItem Header="Saves" DataContext="{Binding Host}" Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Save to host:" VerticalAlignment="Center" />
                        <TextBox Width="260" Margin="6,0" Text="{Binding Profile.SaveName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}" Text="Pick one below, or type a new name to start from default_new_game.sav — which is a vanilla world, with none of this profile's mods in it." />
                    </StackPanel>
                    <!-- Seeding from the game: the server can only ever create a vanilla world, so a world containing
                         this profile's mods has to be started in Bannerlord itself and brought across. -->
                    <Expander DockPanel.Dock="Bottom" Header="Import a world from the game" Margin="0,6,0,0">
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}"
                                       Text="The server cannot build a world with mods in it. Start a campaign in Bannerlord with this profile's mods (Play), then import that save here to host it." />
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Refresh" Command="{Binding RefreshClientSavesCommand}" Padding="10,3" />
                                <Button Content="Import selected" Command="{Binding ImportClientSaveCommand}" Margin="6,0,0,0" Padding="10,3" />
                            </StackPanel>
                            <DataGrid Height="120" ItemsSource="{Binding ClientSaves}" SelectedItem="{Binding SelectedClientSave}" AutoGenerateColumns="False" IsReadOnly="True" RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Save" Binding="{Binding Name}" Width="200" />
                                    <DataGridTextColumn Header="Character" Binding="{Binding Character}" Width="120" />
                                    <DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="60" />
                                    <DataGridTextColumn Header="Written" Binding="{Binding Written}" Width="130" />
                                    <DataGridTextColumn Header="Community modules in save" Binding="{Binding Mods}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Expander>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="80" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="SaveDiffRow" Height="110" MinHeight="60" />
                        </Grid.RowDefinitions>
                        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,2" />
                        <TextBox Grid.Row="2" Text="{Binding SaveDiff, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    <DataGrid Grid.Row="0" ItemsSource="{Binding Saves}" SelectedItem="{Binding SelectedSave}" AutoGenerateColumns="False" IsReadOnly="True" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Save" Binding="{Binding Name}" Width="200" />
                            <DataGridTextColumn Header="Character" Binding="{Binding Character}" Width="120" />
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="50" />
                            <DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="60" />
                            <DataGridTextColumn Header="Written" Binding="{Binding Written}" Width="130" />
                            <DataGridTextColumn Header="Community modules in save" Binding="{Binding Mods}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- SERVER -->
            <TabItem Header="Server" DataContext="{Binding Host}" Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="8" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="Written to server-config.json on every launch (a backup goes to config-backups)." Foreground="{DynamicResource MutedForeground}" Margin="0,0,0,10" />
                    <UniformGrid Columns="2" Rows="16">
                        <TextBlock Text="Join port (UDP, forward this)" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Profile.Server.JoinPort}" />
                        <TextBlock Text="Password (empty = open)" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Profile.Server.Password}" />
                        <TextBlock Text="Steam discoverability" VerticalAlignment="Center" />
                        <CheckBox IsChecked="{Binding Profile.Server.Steam}" HorizontalAlignment="Left" />
                        <TextBlock Text="Steam visibility" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding Visibilities}" SelectedItem="{Binding Profile.Server.Visibility}" />
                        <TextBlock Text="Autosave minutes (0 = off)" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Profile.Server.AutosaveMinutes}" />
                        <TextBlock Text="Server guards (Compat module)" VerticalAlignment="Center" ToolTip="Loads the launcher's DedicatedServer.ModderLordsCompat module on the server: answers inquiries and swallows screen pushes so single-player mods do not crash the headless host. Server-only; players need nothing." />
                        <CheckBox IsChecked="{Binding Profile.CompatGuards}" HorizontalAlignment="Left" />
                        <TextBlock Text="Settings sync (ModderLords.Compat)" VerticalAlignment="Center" ToolTip="Pushes the server's MCM settings to joining players. Adds the shared ModderLords.Compat module to the server AND to the player mod list: every player must install it (copy compatModderLords.Compat from the launcher folder into their game Modules folder) and enable it." />
                        <CheckBox IsChecked="{Binding Profile.SettingsSync}" HorizontalAlignment="Left" />
                        <!-- The one thing this launcher writes inside the DedicatedServer package, so it is opt-in and
                             says so. Turning it off restores SandBox's file on the next launch. -->
                        <TextBlock Text="Use a map mod's distance cache" VerticalAlignment="Center" ToolTip="A map mod replaces the campaign map but the server always reads SandBox's settlement distance cache, which was built for the vanilla map — the mismatch crashes world loading in a loop that never ends. This replaces that file with the one your map mod ships (TAOM_Map ships a rebuilt 10 MB cache). It is the only file the launcher writes inside the DedicatedServer folder; the original is backed up and put back when you untick this. Leave off unless you are running a map-replacing mod." />
                        <CheckBox IsChecked="{Binding Profile.UseModDistanceCache}" HorizontalAlignment="Left" />
                        <TextBlock Text="Warn if loading stalls (seconds)" VerticalAlignment="Center" ToolTip="How long the launch console waits with no loading progress before saying so. Empty uses the default (5 minutes); 0 turns the warning off. Heavy mods can legitimately load for a very long time — TAOM's authors quote up to two hours — so raise it or set 0 for those rather than being nagged." />
                        <TextBox Text="{Binding Profile.StallWarningSeconds, TargetNullValue=''}" />
                        <TextBlock Text="Server log file" VerticalAlignment="Center" />
                        <CheckBox IsChecked="{Binding Profile.Server.LogFile}" HorizontalAlignment="Left" />
                        <TextBlock Text="Engine port / region" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="70" Text="{Binding Profile.Server.EnginePort}" />
                            <ComboBox Width="70" Margin="6,0" ItemsSource="{Binding Regions}" SelectedItem="{Binding Profile.Server.Region}" />
                        </StackPanel>
                        <TextBlock Text="Trace tick / publish / bandits" VerticalAlignment="Center" Foreground="{DynamicResource WarningForeground}"
                                   ToolTip="Diagnostics only. The engine prints hundreds of thousands of lines a second with these on, which fills the launch log with gigabytes and slows the whole machine. Leave them off unless you are chasing a specific bug." />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding Profile.Server.TraceTick}" />
                            <CheckBox IsChecked="{Binding Profile.Server.TracePublish}" />
                            <CheckBox IsChecked="{Binding Profile.Server.TraceBandits}" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource WarningForeground}" TextWrapping="Wrap"
                               Text="Leave the Trace switches off for normal play. They make the engine print hundreds of thousands of lines a second: the launch log grows by gigabytes a minute and the machine slows down. They are for chasing a specific bug, then turning back off." />
                    <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap"
                               Text="Gameplay settings (difficulty, fast forward, cheats) live in CoopData\mod-config.json and are owned by the Coop mod; edit that file directly for now." />
                </StackPanel>
            </TabItem>

            <!-- GAMEPLAY (mod-config.json) -->
            <TabItem Header="Gameplay" DataContext="{Binding Host}" Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Reload" Command="{Binding LoadGameplayCommand}" />
                        <Button Content="Save to mod-config.json" Command="{Binding SaveGameplayCommand}" />
                        <TextBlock VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap"
                                   Text="CoopData\mod-config.json, owned by the Coop mod. Values are replaced in place so its comments stay; a backup goes to config-backups. Applies on the next server start." />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Gameplay}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Section" Binding="{Binding Section}" IsReadOnly="True" Width="100" />
                            <DataGridTextColumn Header="Setting" Binding="{Binding Key}" IsReadOnly="True" Width="300" />
                            <DataGridTemplateColumn Header="Value" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding HasChoices, Converter={StaticResource BoolToVis}}" />
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding HasChoices, Converter={StaticResource InverseBoolToVis}}" BorderThickness="0" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Was" Binding="{Binding Original}" IsReadOnly="True" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- MOD SETTINGS (live MCM edits on the running server) -->
            <TabItem Header="Mod settings" DataContext="{Binding Host}" Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                     IsEnabled="{Binding LiveSettings.IsEnabled}" ToolTip="{Binding LiveSettings.GateHint}" ToolTipService.ShowOnDisabled="True">
                <DockPanel DataContext="{Binding LiveSettings}">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Apply" Command="{Binding ApplyCommand}" FontWeight="Bold" ToolTip="Send the changed values to the running server; players get them on the next sync tick" />
                        <Button Content="Revert" Command="{Binding RevertCommand}" ToolTip="Discard unsent edits in this settings object" />
                        <Button Content="Reload" Command="{Binding ReloadCommand}" ToolTip="Re-read what the server last reported" />
                        <Button Content="Clear overrides" Command="{Binding ClearOverridesCommand}" ToolTip="Forget the stored host overrides for the selected settings object (they are re-applied at every launch until cleared)" />
                        <Border VerticalAlignment="Center" Margin="12,0,0,0" Padding="8,2" CornerRadius="9" Background="{DynamicResource BadgeBackground}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLive}" Value="True"><Setter Property="Background" Value="{DynamicResource SuccessBackground}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ModeText}" FontWeight="Bold" FontSize="11" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" Margin="8,0" Text="{Binding StatusText}" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" MaxWidth="700" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ApplyReport}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SuccessForeground}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SettingsObjectsColumn" Width="260" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="280" />
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Column="0" ItemsSource="{Binding Objects}" SelectedItem="{Binding SelectedObject}" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource MutedForeground}" FontSize="11" TextWrapping="Wrap" />
                                        <TextBlock Foreground="{DynamicResource WarningForeground}" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding OverrideCount, StringFormat='{}{0} override(s)'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OverrideCount}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2,0" />
                        <ScrollViewer Grid.Column="2" Margin="8,0,0,0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedObject.Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,4,0,4" />
                                            <ItemsControl ItemsSource="{Binding Properties}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1" ToolTip="{Binding ToolTip}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="300" />
                                                                <ColumnDefinition Width="240" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsDirty}" Value="True"><Setter Property="FontWeight" Value="Bold" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SubtleForeground}" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Grid Grid.Column="1">
                                                                <CheckBox IsChecked="{Binding BoolValue, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left" />
                                                                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsEnum, Converter={StaticResource BoolToVis}}" />
                                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                                                                <TextBlock Text="{Binding Value}" Foreground="{DynamicResource SubtleForeground}" VerticalAlignment="Center" Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}" TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <Border Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="0,0,8,0"
                                                                        Visibility="{Binding HasOverride, Converter={StaticResource BoolToVis}}" ToolTip="{Binding OverrideTip}">
                                                                    <TextBlock Text="override" FontSize="10" />
                                                                </Border>
                                                                <TextBlock Text="{Binding RangeText}" Foreground="{DynamicResource MutedForeground}" FontSize="11" />
                                                                <TextBlock Text="{Binding KindText}" Foreground="{DynamicResource SubtleForeground}" FontSize="11" Margin="8,0,0,0" Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}" />
                                                                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerForeground}" FontSize="11" Margin="8,0,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- CONSOLE -->
            <TabItem Header="Console" DataContext="{Binding Host}" Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <CheckBox Content="Engine" IsChecked="{Binding ShowEngine}" />
                        <CheckBox Content="Module load" IsChecked="{Binding ShowModuleLoad}" />
                        <CheckBox Content="Server" IsChecked="{Binding ShowServer}" />
                        <CheckBox Content="Coop" IsChecked="{Binding ShowCoop}" />
                        <CheckBox Content="Warnings" IsChecked="{Binding ShowWarnings}" />
                        <CheckBox Content="DLL probes" IsChecked="{Binding ShowProbes}" ToolTip="The engine tries every referenced DLL by bare name first and logs a miss before resolving it properly. Harmless." />
                        <CheckBox Content="Console input + replies" IsChecked="{Binding ShowConsoleIo}"
                                  ToolTip="Show the commands you type and whatever the server prints just after them. Stays visible even with &quot;Errors + milestones only&quot; ticked." />
                        <CheckBox Content="Errors + milestones only" IsChecked="{Binding ErrorsOnly}" />
                        <CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScroll}"
                                  ToolTip="Follow the newest output. Ticking it jumps to the bottom now; untick it to stop and read." />
                        <TextBlock Text="Find:" VerticalAlignment="Center" Margin="12,0,4,0" />
                        <TextBox Width="220" Text="{Binding ConsoleFilter, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Logs folder" Command="{Binding OpenLogsFolderCommand}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Send" Command="{Binding SendCommandCommand}" />
                            <TextBox Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" KeyDown="Command_KeyDown"
                                     IsEnabled="{Binding IsRunning}" FontFamily="Consolas" />
                        </DockPanel>
                        <TextBlock Text="{Binding CommandStatus}" Foreground="{DynamicResource MutedForeground}" Margin="2,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox x:Name="ConsoleList" ItemsSource="{Binding ConsoleView}" FontFamily="Consolas" FontSize="12"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.VerticalScrollBarVisibility="Visible">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Time}" Foreground="{DynamicResource LogTimestamp}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Category}" Width="80" Foreground="{DynamicResource MutedForeground}" />
                                    <TextBlock Text="{Binding Text}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static logs:LogCategory.Error}"><Setter Property="Foreground" Value="{DynamicResource LogError}" /><Setter Property="FontWeight" Value="Bold" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static logs:LogCategory.Warning}"><Setter Property="Foreground" Value="{DynamicResource LogWarning}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static logs:LogCategory.Milestone}"><Setter Property="Foreground" Value="{DynamicResource LogMilestone}" /><Setter Property="FontWeight" Value="Bold" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static logs:LogCategory.Tool}"><Setter Property="Foreground" Value="{DynamicResource LogTool}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static logs:LogCategory.Command}"><Setter Property="Foreground" Value="{DynamicResource LogCommand}" /><Setter Property="FontWeight" Value="Bold" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static logs:LogCategory.CommandReply}"><Setter Property="Foreground" Value="{DynamicResource LogCommandReply}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static logs:LogCategory.Probe}"><Setter Property="Foreground" Value="{DynamicResource LogProbe}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static logs:LogCategory.Engine}"><Setter Property="Foreground" Value="{DynamicResource LogEngine}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static logs:LogCategory.ModuleLoad}"><Setter Property="Foreground" Value="{DynamicResource LogModuleLoad}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static logs:LogCategory.Coop}"><Setter Property="Foreground" Value="{DynamicResource LogCoop}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- SHARE: hand your mod list to somebody, or take theirs. That half is the whole point of a mod
                 loader, so it is in both modes; the right-hand column compares this PC's launcher with the server
                 you are hosting, so that half is Host mode only. -->
            <TabItem Header="Share">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{Binding IsHost, Converter={StaticResource HostColumnWidth}}" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="0,0,6,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Mod list" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Content="Copy" Command="{Binding CopyManifestCommand}" />
                <Button Content="Export…" Command="{Binding ExportListCommand}"
                        ToolTip="Save this mod list, versions and load order to a file you can send to a player or another host" />
                <Button Content="Import…" Command="{Binding ImportListCommand}"
                        ToolTip="Read a mod list somebody shared: set up this PC's Bannerlord launcher to match, and/or create a server profile from it" />
                        </StackPanel>
                        <TextBox Text="{Binding ClientManifestText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </DockPanel>
                    <DockPanel Grid.Column="1" Margin="6,0,0,0" DataContext="{Binding Host}"
                               Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="This PC's Bannerlord launcher vs the server" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Content="Check my client" Command="{Binding CheckMyClientCommand}" />
                <Button Content="Match server…" Command="{Binding MatchServerCommand}"
                        ToolTip="Show what Launch client would change in this PC's Bannerlord launcher mod list, and optionally apply it now" />
                        </StackPanel>
                        <TextBox Text="{Binding ClientCheckText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- PERFORMANCE -->
            <TabItem Header="Performance" DataContext="{Binding Host}" Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Performance.SessionState}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" Margin="0,0,0,8"
                               Text="Measured against what YOUR server normally does this session, not against fixed numbers — the first minute after launch is ignored as world load. Samples arrive every 10 seconds." />

                    <Border DockPanel.Dock="Top" Padding="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Campaign time: " Foreground="{DynamicResource MutedForeground}" />
                            <TextBlock Text="{Binding Performance.CampaignMode}" Margin="0,0,20,0" />
                            <TextBlock Text="Players: " Foreground="{DynamicResource MutedForeground}" />
                            <TextBlock Text="{Binding Performance.Players}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Performance.PlayersNote}" Foreground="{DynamicResource MutedForeground}" FontStyle="Italic" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Performance.Metrics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,8">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Value}" HorizontalAlignment="Right" DockPanel.Dock="Right" FontFamily="Consolas" FontSize="15" />
                                            </DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,2">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Departed}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBorder}" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Explanation}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedForeground}" FontSize="11" Margin="0,4,0,0" />
                                            <controls:Sparkline Values="{Binding History}" BandLow="{Binding BandLow}"
                                                                BandHigh="{Binding BandHigh}" HasBand="{Binding HasBand}" Height="52" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
