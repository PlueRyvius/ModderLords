<Window x:Class="ModderLords.App.ProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ModderLords.App.Localization"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Foreground}"
        Title="{l:T 'Profiles'}" Height="560" Width="900" MinWidth="680" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BadgeBackground}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding UseCommand}" />
    </Window.InputBindings>
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="{l:T 'New profile'}" Command="{Binding NewProfileCommand}" Margin="8,0,0,0" />
            <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="240" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                     ToolTip="{l:T 'Search profiles by name, or by a mod they contain'}" />
            <TextBlock DockPanel.Dock="Right" Text="{l:T 'Search'}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource MutedForeground}" />
            <TextBlock Text="{l:T 'Right-click a profile for more. Drag it onto a group to move it.'}" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource MutedForeground}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" MinWidth="130" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="230" MinWidth="180" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <Button DockPanel.Dock="Bottom" Content="{l:T 'New group'}" Command="{Binding NewGroupCommand}" Margin="0,6,0,0" />
                <ListBox x:Name="GroupList" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" AllowDrop="True"
                         DragOver="Group_DragOver" Drop="Group_Drop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{DynamicResource MutedForeground}" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="6,4" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource SplitterBrush}" />

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1,1,1,0" Padding="8,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:T 'Name'}" Foreground="{DynamicResource MutedForeground}" />
                        <TextBlock Grid.Column="1" Text="{l:T 'Mods'}" Foreground="{DynamicResource MutedForeground}" />
                        <TextBlock Grid.Column="2" Text="{l:T 'Status'}" Foreground="{DynamicResource MutedForeground}" />
                    </Grid>
                </Border>
                <ListBox x:Name="ProfileList" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" SelectionMode="Single"
                         MouseDoubleClick="Profile_DoubleClick" PreviewMouseLeftButtonDown="Profile_MouseDown" PreviewMouseMove="Profile_MouseMove">
                    <!-- On the list, not the window: in the search box these keys edit the text. -->
                    <ListBox.InputBindings>
                        <KeyBinding Key="F2" Command="{Binding RenameCommand}" />
                        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                    </ListBox.InputBindings>
                <ListBox.ContextMenu>
                    <ContextMenu Opened="ProfileMenu_Opened">
                        <MenuItem Header="{l:T 'Use'}" Command="{Binding UseCommand}" FontWeight="Bold" />
                        <MenuItem Header="{l:T 'Rename…'}" Command="{Binding RenameCommand}" InputGestureText="F2" />
                        <MenuItem Header="{l:T 'Duplicate…'}" Command="{Binding DuplicateCommand}" />
                        <MenuItem x:Name="PinItem" Header="{l:T 'Pin'}" Command="{Binding TogglePinCommand}" />
                        <MenuItem x:Name="MoveToItem" Header="{l:T 'Move to group'}" />
                        <Separator />
                        <MenuItem Header="{l:T 'Delete…'}" Command="{Binding DeleteCommand}" InputGestureText="Del" Foreground="{DynamicResource DangerForeground}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="6,4" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Grid.Column="0" Focusable="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x2022;" Margin="0,0,4,0" Foreground="{DynamicResource LogTool}" ToolTip="{l:T 'Pinned'}"
                                                   Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Name}" />
                                        <Border Style="{StaticResource Badge}" Visibility="{Binding HasCoop, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{l:T 'Coop'}" FontSize="11" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{l:T 'In use'}" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                </ContentControl>
                                <TextBlock Grid.Column="1" Text="{Binding ModCount}" />
                                <ContentControl Grid.Column="2" Focusable="False">
                                    <Border CornerRadius="3" Padding="6,0" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBackground}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Missing"><Setter Property="Background" Value="{DynamicResource WarningBackground}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Changed"><Setter Property="Background" Value="{DynamicResource WarningBackground}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Unreadable"><Setter Property="Background" Value="{DynamicResource DangerBackground}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusText}" Value=""><Setter Property="Background" Value="Transparent" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessForeground}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Missing"><Setter Property="Foreground" Value="{DynamicResource WarningForeground}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Changed"><Setter Property="Foreground" Value="{DynamicResource WarningForeground}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Unreadable"><Setter Property="Foreground" Value="{DynamicResource DangerForeground}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </ContentControl>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="{DynamicResource SplitterBrush}" />

            <Border Grid.Column="4" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource GridLine}" BorderThickness="1" Padding="10">
                <DockPanel DataContext="{Binding Selected}">
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Content="{l:T 'Use this profile'}" Command="{Binding DataContext.UseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="{DynamicResource SelectionBackground}" FontWeight="Bold" Padding="8,4" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" Margin="0,2,0,10" />
                        <TextBlock Text="{Binding StatusText}" FontWeight="Bold" />
                        <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
