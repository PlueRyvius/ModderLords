<Window x:Class="ModderLords.App.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Foreground}"
        Title="Welcome to ModderLords" SizeToContent="Height" Width="560"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="What are you here to do?" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,16"
                   Text="You can change this at any time from the button in the toolbar." />

        <Button x:Name="PlayerButton" Click="Player_Click" IsDefault="True" Padding="14" HorizontalContentAlignment="Left">
            <StackPanel>
                <TextBlock Text="Play with mods" FontSize="15" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,3,0,0"
                           Text="Pick a set of mods, put them in the right order, and launch Bannerlord straight from here." />
            </StackPanel>
        </Button>

        <Button x:Name="HostButton" Click="Host_Click" Padding="14" Margin="0,10,0,0" HorizontalContentAlignment="Left">
            <StackPanel>
                <TextBlock Text="Host a coop server" FontSize="15" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,3,0,0"
                           Text="Everything above, plus running the Bannerlord Coop dedicated server: its console, saves and settings." />
            </StackPanel>
        </Button>
    </StackPanel>
</Window>
