<Window x:Class="ModderLords.App.SupportReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ModderLords.App.Localization"
        Title="{l:T 'Report a problem'}" Width="720" Height="620" MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Foreground}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{l:T 'Cancel'}" IsCancel="True" MinWidth="90" Margin="4,0" />
            <Button Content="{l:T 'Create bundle and open report'}" IsDefault="True" MinWidth="210" Margin="4,0"
                    Click="Create_Click" FontWeight="Bold" Background="{DynamicResource SuccessBackground}" />
        </StackPanel>

        <StackPanel>
            <TextBlock Text="{l:T 'Create a support bundle'}" FontSize="20" FontWeight="Bold" />
            <TextBlock Margin="0,6,0,12" TextWrapping="Wrap"
                       Text="{l:T 'ModderLords will make a redacted ZIP on this computer, open the GitHub report form, and select the ZIP in Explorer so you can drag it into the form. Nothing is uploaded automatically.'}" />

            <Border Padding="10" Margin="0,0,0,12" Background="{DynamicResource WarningBackground}"
                    BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1" CornerRadius="3">
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="Bold" Text="{l:T 'GitHub reports and attachments are public. '}" />
                    <Run Text="{l:T 'Passwords, common identifiers and personal path prefixes are redacted, but a mod can write arbitrary user text to its own logs. Review the ZIP before posting it.'}" />
                </TextBlock>
            </Border>

            <TextBlock Text="{l:T 'Included diagnostics'}" FontWeight="Bold" Margin="0,0,0,5" />
            <DataGrid x:Name="CategoriesGrid" Height="245" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" RowHeaderWidth="0" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T 'Category'}" Binding="{Binding Name}" Width="190" />
                    <DataGridTextColumn Header="{l:T 'Contents'}" Binding="{Binding Detail}" Width="*" />
                    <DataGridTextColumn Header="{l:T 'Estimated'}" Binding="{Binding DisplaySize}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="{l:T 'Optional save'}" FontWeight="Bold" Margin="0,14,0,5" />
            <ComboBox x:Name="SaveBox" MinWidth="500" HorizontalAlignment="Left" />
            <TextBlock x:Name="SaveNote" Margin="0,5,0,0" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" />
            <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap"
                       Text="{l:T 'Large text logs are reduced to their beginning and end. The diagnostics ZIP is held below 20 MiB. An optional save is packaged separately and must fit GitHub\&#x27;s 25 MB archive limit.'}" />
        </StackPanel>
    </DockPanel>
</Window>
