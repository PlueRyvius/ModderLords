<Window x:Class="ModularCoop.App.BehaviorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Server-only behaviours" Height="480" Width="720" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" x:Name="Header" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,8"
                   Text="Ticked behaviours run on the server only: players' copies skip them and receive the results through Coop. Untick a behaviour to keep it running on players' clients too (typically a mod's own UI/menu behaviour). Campaign behaviours are gated at RegisterEvents; mission behaviours are dropped when a battle starts on the client." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="All server-only" Click="All_Click" MinWidth="110" Margin="4,0" />
            <Button Content="OK" Click="Ok_Click" MinWidth="80" Margin="4,0" IsDefault="True" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="4,0" />
        </StackPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Server-only" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding ServerOnly, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" IsReadOnly="True" Width="90" />
                <DataGridTextColumn Header="Behaviour class" Binding="{Binding TypeName}" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
