<Window x:Class="ModularCoop.App.CompatRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compatibility record" Height="520" Width="640" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" x:Name="Header" FontWeight="Bold" Margin="0,0,0,2" />
        <TextBlock DockPanel.Dock="Top" x:Name="SourceLine" Foreground="#666" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="RemoveButton" Content="Remove local record" Click="Remove_Click" MinWidth="130" Margin="0,0,4,0"
                    ToolTip="Delete your local record for this mod so the bundled one (if any) shows again" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft" Width="380">
                <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="4,0" />
                <Button Content="Save" Click="Save_Click" MinWidth="80" Margin="4,0" IsDefault="True" />
            </StackPanel>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,6,8,0" /></Style>
            </Grid.Resources>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Verdict" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="VerdictBox" Margin="0,4,0,0" HorizontalAlignment="Left" Width="200" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tested" />
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
                <CheckBox x:Name="TestedBox" />
                <TextBlock x:Name="TestedLine" Foreground="#666" Margin="0,2,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Defaults for new profiles" />
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,4,0,0">
                <TextBlock x:Name="DefaultsLine" Margin="0,2,0,4" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Use current row as defaults" Click="UseRow_Click" MinWidth="170"
                            ToolTip="Copy this mod's Role, Server-only logic and client-side behaviours from the Mods tab into the record" />
                    <Button Content="Clear defaults" Click="ClearDefaults_Click" MinWidth="100" Margin="6,0,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Link" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="UrlBox" Margin="0,4,0,0" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Notes" />
            <TextBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" x:Name="NotesBox" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" MinHeight="120" />
        </Grid>
    </DockPanel>
</Window>
