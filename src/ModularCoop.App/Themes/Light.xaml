<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme. Every brush key here must also exist in Dark.xaml; the two are swapped wholesale
         at runtime, so a key present in one and missing from the other throws on switch. -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ChromeBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="ControlBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBorder" Color="#ABADB3" />
    <SolidColorBrush x:Key="GridLine" Color="#D8D8D8" />
    <SolidColorBrush x:Key="HeaderBackground" Color="#F0F0F0" />
    <SolidColorBrush x:Key="SelectionBackground" Color="#CCE4F7" />
    <SolidColorBrush x:Key="SplitterBrush" Color="#DDDDDD" />

    <!-- Text -->
    <SolidColorBrush x:Key="Foreground" Color="#000000" />
    <SolidColorBrush x:Key="MutedForeground" Color="#666666" />
    <SolidColorBrush x:Key="SubtleForeground" Color="#999999" />

    <!-- Semantic fills: launch/stop buttons, the drift banner, override chips -->
    <SolidColorBrush x:Key="SuccessBackground" Color="#DFF0D8" />
    <SolidColorBrush x:Key="SuccessForeground" Color="#2E7D32" />
    <SolidColorBrush x:Key="DangerBackground" Color="#F2DEDE" />
    <SolidColorBrush x:Key="DangerForeground" Color="#C62828" />
    <SolidColorBrush x:Key="WarningBackground" Color="#FFF4CE" />
    <SolidColorBrush x:Key="WarningBorder" Color="#E0C060" />
    <SolidColorBrush x:Key="WarningForeground" Color="#B26A00" />
    <SolidColorBrush x:Key="BadgeBackground" Color="#DDDDDD" />

    <!-- Console log categories. Keep these distinguishable from each other, not just from the background:
         a user scanning the console reads by colour before they read the category column. -->
    <SolidColorBrush x:Key="LogError" Color="#CC0000" />
    <SolidColorBrush x:Key="LogWarning" Color="#AA6600" />
    <SolidColorBrush x:Key="LogMilestone" Color="#008800" />
    <SolidColorBrush x:Key="LogTool" Color="#0066AA" />
    <SolidColorBrush x:Key="LogProbe" Color="#AAAAAA" />
    <SolidColorBrush x:Key="LogEngine" Color="#888888" />
    <SolidColorBrush x:Key="LogModuleLoad" Color="#006677" />
    <SolidColorBrush x:Key="LogCoop" Color="#6633AA" />
    <SolidColorBrush x:Key="LogTimestamp" Color="#999999" />

    <!-- Buttons and tabs are fully templated in Shared.xaml, so these are honoured on every state. -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#FDFDFD" />
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#E5F1FB" />
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#CCE4F7" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#ADADAD" />
    <SolidColorBrush x:Key="DisabledForeground" Color="#9A9A9A" />
    <SolidColorBrush x:Key="DisabledBackground" Color="#F0F0F0" />
    <SolidColorBrush x:Key="TabBackground" Color="#ECECEC" />
    <SolidColorBrush x:Key="TabHoverBackground" Color="#DCDCDC" />
    <SolidColorBrush x:Key="TabSelectedBackground" Color="#FFFFFF" />

</ResourceDictionary>
