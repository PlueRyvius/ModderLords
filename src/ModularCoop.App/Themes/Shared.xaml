<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Control styles shared by both themes. Everything colour-bearing here uses DynamicResource so a
         theme swap repaints live rather than needing a restart.

         Why the container controls (DataGrid, ListBox, TabControl, ComboBox) are styled at all: WPF's
         stock templates paint themselves white regardless of what the window's brushes say, so without
         these the dark theme would leave the Mods grid and the console blazing white. These set colours
         only — no retemplating — so the Aero chrome, focus rings and mouse-over behaviour are untouched. -->

    <!-- Text foreground is inherited (TextElement.Foreground), so setting it on Window carries it to every
         TextBlock and Run in the tree. That is deliberate: it means no implicit TextBlock style, which would
         otherwise be wholly replaced by any local TextBlock style (as in CompatRecordWindow's Grid.Resources)
         and silently drop the theme colour there. -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="MinWidth" Value="70" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="3" />
        <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Foreground}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        <Setter Property="RowBackground" Value="{DynamicResource ControlBackground}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource ControlBackground}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLine}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridLine}" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
    </Style>

    <!-- Cells stay transparent so the row brush (and selection) shows through. -->
    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource HeaderBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GridLine}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="4,3" />
    </Style>

    <!-- Splitters read as a seam in the chrome rather than a control. -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource SplitterBrush}" />
        <Setter Property="ShowsPreview" Value="True" />
    </Style>

</ResourceDictionary>
