<Project>
  <!--
    The one place the version lives. Without it every build reported 1.0.0, which made a dev build and a release
    indistinguishable in the title bar — and left no way to tell which build someone was reporting a bug from.

    Bump this when cutting a release; scripts\package-release.ps1 refuses to package a different number, so the two
    cannot drift apart.
  -->
  <PropertyGroup>
    <VersionPrefix>1.8.1</VersionPrefix>
  </PropertyGroup>

  <!--
    ModderLords.CompatSync.Coop compiles against Coop's own assemblies, which ship inside the Coop workshop item
    rather than on NuGet. Anyone building the mod loader without a Coop subscription - CI included - has no copy of
    them, and that one project used to take the whole app down with it: it is project-referenced by App and Cli, so
    CI could only ever build Core.

    So the location is resolved here, once, and HasCoopAssemblies says whether it was found. The projects that need
    those assemblies are conditioned on it and simply drop out when they cannot be built; the release script refuses
    to package a build that is missing them. Override with -p:CoopRefDir=... for a Steam library somewhere else.
  -->
  <PropertyGroup>
    <CoopWorkshopBin>steamapps\workshop\content\261550\3770450698\bin\Win64_Shipping_Client</CoopWorkshopBin>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CoopRefDir)' == ''">
    <CoopRefDir Condition="Exists('C:\Program Files (x86)\Steam\$(CoopWorkshopBin)')">C:\Program Files (x86)\Steam\$(CoopWorkshopBin)</CoopRefDir>
    <CoopRefDir Condition="'$(CoopRefDir)' == '' And Exists('D:\Program Files (x86)\Steam\$(CoopWorkshopBin)')">D:\Program Files (x86)\Steam\$(CoopWorkshopBin)</CoopRefDir>
    <CoopRefDir Condition="'$(CoopRefDir)' == '' And Exists('D:\SteamLibrary\$(CoopWorkshopBin)')">D:\SteamLibrary\$(CoopWorkshopBin)</CoopRefDir>
    <CoopRefDir Condition="'$(CoopRefDir)' == '' And Exists('E:\SteamLibrary\$(CoopWorkshopBin)')">E:\SteamLibrary\$(CoopWorkshopBin)</CoopRefDir>
  </PropertyGroup>
  <PropertyGroup>
    <HasCoopAssemblies Condition="'$(CoopRefDir)' != '' And Exists('$(CoopRefDir)')">true</HasCoopAssemblies>
    <HasCoopAssemblies Condition="'$(HasCoopAssemblies)' == ''">false</HasCoopAssemblies>
  </PropertyGroup>

  <!--
    The same for test modules whose steps call a mod's own code (ModderLords.Tests.<Module>): each compiles against
    that mod's installed DLL and drops out where the mod is not installed. Override with -p:RetinuesRefDir=...
  -->
  <PropertyGroup>
    <RetinuesBin>steamapps\common\Mount &amp; Blade II Bannerlord\Modules\Retinues\bin\Win64_Shipping_Client</RetinuesBin>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RetinuesRefDir)' == ''">
    <RetinuesRefDir Condition="Exists('C:\Program Files (x86)\Steam\$(RetinuesBin)\Retinues.dll')">C:\Program Files (x86)\Steam\$(RetinuesBin)</RetinuesRefDir>
    <RetinuesRefDir Condition="'$(RetinuesRefDir)' == '' And Exists('D:\Program Files (x86)\Steam\$(RetinuesBin)\Retinues.dll')">D:\Program Files (x86)\Steam\$(RetinuesBin)</RetinuesRefDir>
    <RetinuesRefDir Condition="'$(RetinuesRefDir)' == '' And Exists('D:\SteamLibrary\$(RetinuesBin)\Retinues.dll')">D:\SteamLibrary\$(RetinuesBin)</RetinuesRefDir>
    <RetinuesRefDir Condition="'$(RetinuesRefDir)' == '' And Exists('E:\SteamLibrary\$(RetinuesBin)\Retinues.dll')">E:\SteamLibrary\$(RetinuesBin)</RetinuesRefDir>
  </PropertyGroup>
  <PropertyGroup>
    <HasRetinuesAssemblies Condition="'$(RetinuesRefDir)' != '' And Exists('$(RetinuesRefDir)\Retinues.dll')">true</HasRetinuesAssemblies>
    <HasRetinuesAssemblies Condition="'$(HasRetinuesAssemblies)' == ''">false</HasRetinuesAssemblies>
  </PropertyGroup>

  <!-- Modular Smithing 2 (test module smithing): its Core and Crafting DLLs. Override with -p:SmithingRefDir=... -->
  <PropertyGroup>
    <SmithingBin>steamapps\common\Mount &amp; Blade II Bannerlord\Modules\ModularSmithing2\bin\Win64_Shipping_Client</SmithingBin>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SmithingRefDir)' == ''">
    <SmithingRefDir Condition="Exists('C:\Program Files (x86)\Steam\$(SmithingBin)\ModularSmithing.Crafting.dll')">C:\Program Files (x86)\Steam\$(SmithingBin)</SmithingRefDir>
    <SmithingRefDir Condition="'$(SmithingRefDir)' == '' And Exists('D:\Program Files (x86)\Steam\$(SmithingBin)\ModularSmithing.Crafting.dll')">D:\Program Files (x86)\Steam\$(SmithingBin)</SmithingRefDir>
    <SmithingRefDir Condition="'$(SmithingRefDir)' == '' And Exists('D:\SteamLibrary\$(SmithingBin)\ModularSmithing.Crafting.dll')">D:\SteamLibrary\$(SmithingBin)</SmithingRefDir>
    <SmithingRefDir Condition="'$(SmithingRefDir)' == '' And Exists('E:\SteamLibrary\$(SmithingBin)\ModularSmithing.Crafting.dll')">E:\SteamLibrary\$(SmithingBin)</SmithingRefDir>
  </PropertyGroup>
  <PropertyGroup>
    <HasSmithingAssemblies Condition="'$(SmithingRefDir)' != '' And Exists('$(SmithingRefDir)\ModularSmithing.Crafting.dll')">true</HasSmithingAssemblies>
    <HasSmithingAssemblies Condition="'$(HasSmithingAssemblies)' == ''">false</HasSmithingAssemblies>
  </PropertyGroup>

</Project>
