<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ModularCoop.Core\ModularCoop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine-side JSON used for the live-settings files, compiled in so the tests prove both ends read the same bytes. -->
    <Compile Include="..\..\src\ModularCoop.CompatSync\MiniJson.cs" Link="Module\MiniJson.cs" />
    <Compile Include="..\..\src\ModularCoop.CompatSync\ValueConverter.cs" Link="Module\ValueConverter.cs" />
    <Compile Include="..\..\src\ModularCoop.CompatSync\PropertyRef.cs" Link="Module\PropertyRef.cs" />
  </ItemGroup>

</Project>