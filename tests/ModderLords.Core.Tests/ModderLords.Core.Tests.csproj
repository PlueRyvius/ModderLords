<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- Real Harmony for RecipeGatesTests (the module's own copy is compile-time only). -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ModderLords.Core\ModderLords.Core.csproj" />
    <ProjectReference Include="..\..\src\ModderLords.Coop\ModderLords.Coop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine-side JSON used for the live-settings files, compiled in so the tests prove both ends read the same bytes. -->
    <Compile Include="..\..\src\ModderLords.CompatSync\MiniJson.cs" Link="Module\MiniJson.cs" />
    <Compile Include="..\..\src\ModderLords.CompatSync\ValueConverter.cs" Link="Module\ValueConverter.cs" />
    <Compile Include="..\..\src\ModderLords.CompatSync\PropertyRef.cs" Link="Module\PropertyRef.cs" />
    <!-- World creation's decision-making, kept free of TaleWorlds types precisely so it can be compiled in
         here. The compat module has no other test coverage, and the spike harness greps the strings this
         file emits, so both ends of that contract are asserted from one source. -->
    <Compile Include="..\..\src\ModderLords.Compat\CreateWorldPolicy.cs" Link="Module\CreateWorldPolicy.cs" />
    <!-- Which failed asserts reach the engine log; TaleWorlds-free for the same reason. -->
    <Compile Include="..\..\src\ModderLords.Compat\AssertThrottlePolicy.cs" Link="Module\AssertThrottlePolicy.cs" />
    <!-- The encounter option gate's decisions, TaleWorlds- and Coop-free for the same reason. -->
    <Compile Include="..\..\src\ModderLords.CompatSync.Coop\EncounterOptionGatePolicy.cs" Link="Module\EncounterOptionGatePolicy.cs" />
    <Compile Include="..\..\src\ModderLords.CompatSync.Coop\RecipeGates.cs" Link="Module\RecipeGates.cs" />
    <Compile Include="..\..\src\ModderLords.CompatSync.Coop\PlayerComparisonRewriter.cs" Link="Module\PlayerComparisonRewriter.cs" />
  </ItemGroup>

</Project>