<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The command-line end of ModderLords.Core's CompatIntake: CI runs "check" on the committed compat-db.json, and the
    compat-record workflow runs "intake" on a submitted issue. See docs/COMPAT-RECORDS.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ModderLords.Core/ModderLords.Core.csproj" />
  </ItemGroup>

</Project>
